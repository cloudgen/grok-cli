    out_plain "  backup               Push ~/.grok/auth.* to ${GROK_CLI_ROOT}/"
    out_plain "                       (runs grok -p hello first; sudo -n ${GLOBAL_BIN}/${APP_NAME} backup after sudoer-adm grant;"
