# =============================================================================
# Domain helpers (gc_*) — grok-cli
# ALIGNMENT: requirement-domain-grok-cli.md
# Ops SSOT: requirement-grok-auth-backup.md
# Specialized from sibling grok-cli Type 0 + privilege; do not reverse-copy.
# =============================================================================

# =============================================================================
# gc_invoking_login() / gc_invoking_home() — SUDO_USER-aware identity (Class B)
# =============================================================================
#
# GENERAL PURPOSE:
# When backup is re-exec'd as root via allowlisted sudo, HOME often becomes
# /root. Use SUDO_USER's passwd home so auth.* still come from the login that
# ran grok login.
# =============================================================================
gc_invoking_login() {
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
        printf '%s' "${SUDO_USER}"
        return 0
    fi
    id -un 2>/dev/null || echo "unknown"
}

gc_invoking_home() {
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
        _h=""
        if command -v getent >/dev/null 2>&1; then
            _h=$(getent passwd "${SUDO_USER}" 2>/dev/null | cut -d: -f6)
        fi
        if [ -z "${_h}" ] && [ -r /etc/passwd ]; then
            _h=$(awk -F: -v u="${SUDO_USER}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
        fi
        if [ -n "${_h}" ] && [ -d "${_h}" ]; then
            printf '%s' "${_h}"
            return 0
        fi
    fi
    printf '%s' "${HOME:-/tmp}"
}

# =============================================================================
# gc_resolve_grok_home() - ~/.grok (or GROK_HOME) for the invoking login
# =============================================================================
gc_resolve_grok_home() {
    if [ -n "${GROK_HOME:-}" ]; then
        printf '%s' "${GROK_HOME}"
        return 0
    fi
    printf '%s' "$(gc_invoking_home)/.grok"
}

# =============================================================================
# gc_resolve_grok_peer() - path of peer grok CLI (class B)
# =============================================================================
#
# GENERAL PURPOSE:
# Locate the xAI grok binary: GROK_BIN override, else command -v grok, else
# the vendor dir (~/.grok/bin) and USER_BIN. Disk search is required because
# setup writes PATH into ~/.bashrc; that does not apply to the
# current session. Empty string means not found. Does not mean grok-cli is
# installed.
#
# PRINTF EXCEPTION (class B): path data for $(…) capture only.
#
# ALIGNMENT:
# - requirement-grok-setup.md
# - requirement-grok-auth-backup.md
#
# Last updated: 2026-09-06
# =============================================================================
gc_resolve_grok_peer() {
    : "${GROK_PEER_NAME:=grok}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    if [ -n "${GROK_BIN:-}" ] && [ -x "${GROK_BIN}" ]; then
        printf '%s' "${GROK_BIN}"
        return 0
    fi
    _p=$(command -v "${GROK_PEER_NAME}" 2>/dev/null || true)
    if [ -n "${_p}" ] && [ -x "${_p}" ]; then
        printf '%s' "${_p}"
        return 0
    fi
    _vendor_bin="$(gc_resolve_grok_home)/bin/${GROK_PEER_NAME}"
    if [ -x "${_vendor_bin}" ]; then
        printf '%s' "${_vendor_bin}"
        return 0
    fi
    # sudo env_reset leaves USER_BIN at /root/.local/bin; still find this login's grok.
    _inv_bin="$(gc_invoking_home)/.local/bin/${GROK_PEER_NAME}"
    if [ -x "${_inv_bin}" ]; then
        printf '%s' "${_inv_bin}"
        return 0
    fi
    if [ -x "${USER_BIN}/${GROK_PEER_NAME}" ]; then
        printf '%s' "${USER_BIN}/${GROK_PEER_NAME}"
        return 0
    fi
    printf ''
}

# =============================================================================
# gc_run_grok() - Start peer grok without auto-update
# =============================================================================
#
# GENERAL PURPOSE:
# Exec the xAI grok peer with --no-auto-update so Termux/proot is not
# left waiting on grok's updater. Remaining argv is passed through
# (grok-cli run -p hello → grok --no-auto-update -p hello). Missing
# grok fail-closes. --json does not exec (TUI / one-shot is not JSON).
#
# ALIGNMENT:
# - requirement-grok-setup.md
# - requirement-shell-cli-interface.md
# - requirement-domain-grok-cli.md
#
# Lessons Learned (CIAO Reflection):
# 2026-09-07: operator grok hung after the answer until Ctrl-Z (PRoot
# leftover children / auto-update). A named verb starts grok without
# that updater. INC-20260907-002.
#
# Last updated: 2026-09-07
# =============================================================================
gc_run_grok() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    if [ "${JSON}" -eq 1 ]; then
        out_die "run starts grok in the terminal, so --json cannot be used. Next: ${APP_NAME} run"
    fi
    _peer=$(gc_resolve_grok_peer)
    if [ -z "${_peer}" ] || [ ! -x "${_peer}" ]; then
        out_die "grok is not installed, so ${APP_NAME} cannot start it. Next: ${APP_NAME} setup"
    fi
    _has_nau=0
    for _a in "$@"; do
        if [ "${_a}" = "--no-auto-update" ]; then
            _has_nau=1
        fi
    done
    if [ "${_has_nau}" -eq 1 ]; then
        exec "${_peer}" "$@"
        out_die "Could not start grok at ${_peer}. Next: ${APP_NAME} setup"
    fi
    exec "${_peer}" --no-auto-update "$@"
    out_die "Could not start grok at ${_peer}. Next: ${APP_NAME} setup"
}

# =============================================================================
# gc_peer_on_current_path() - 0 if this shell can command -v grok
# =============================================================================
#
# GENERAL PURPOSE:
# Distinguishes "grok exists on disk" from "this session's PATH already
# includes it". Vendor PATH edits in ~/.bashrc do not take effect until a
# new session.
#
# ALIGNMENT:
# - requirement-grok-setup.md
#
# Last updated: 2026-08-30
# =============================================================================
gc_peer_on_current_path() {
    : "${GROK_PEER_NAME:=grok}"
    _p=$(command -v "${GROK_PEER_NAME}" 2>/dev/null || true)
    if [ -n "${_p}" ] && [ -x "${_p}" ]; then
        return 0
    fi
    return 1
}

# =============================================================================
# gc_setup_print_next() - Next: after setup found a peer binary
# =============================================================================
#
# GENERAL PURPOSE:
# Tell the operator the next command. If grok is on disk but this shell
# cannot see it, that is expected (rc PATH is not live yet) — INFO, not ERROR.
#
# ALIGNMENT:
# - requirement-grok-setup.md
# - requirement-operator-readable-error.md
#
# Last updated: 2026-08-30
# =============================================================================
gc_setup_print_next() {
    : "${APP_NAME:=grok-cli}"
    _peer="${1:-}"
    if [ -z "${_peer}" ]; then
        return 1
    fi
    if gc_peer_on_current_path; then
        out_info "Next: grok login, then ${APP_NAME} check-session."
        return 0
    fi
    _peer_dir=$(dirname "${_peer}")
    out_info "This shell does not have ${_peer_dir} on PATH yet. A PATH line in ~/.bashrc does not apply until a new session."
    out_info "Next: open a new terminal, then grok login, then ${APP_NAME} check-session."
}

# =============================================================================
# gc_setup_version_ok() - 0 if X.Y.Z or X.Y.Z-suffix
# =============================================================================
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-02
# =============================================================================
gc_setup_version_ok() {
    printf '%s' "${1:-}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9._]+)?$'
}

# =============================================================================
# gc_setup_path_has_dir() - 0 if dir is already on PATH
# =============================================================================
gc_setup_path_has_dir() {
    case ":${PATH}:" in
        *":${1}:"*) return 0 ;;
        *) return 1 ;;
    esac
}

# =============================================================================
# gc_setup_detect_platform() - Class B: print os-arch (linux-aarch64, …)
# =============================================================================
#
# GENERAL PURPOSE:
# Same OS/arch map as the studied xAI installer (Darwin→macos, Linux→linux;
# x86_64/amd64, aarch64/arm64; macOS Rosetta → aarch64). Empty + return 1
# when unsupported. Windows is out of scope for this POSIX ship unit.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-02
# =============================================================================
gc_setup_detect_platform() {
    _sys=$(uname -s 2>/dev/null) || _sys=""
    _mach=$(uname -m 2>/dev/null) || _mach=""
    case "${_sys}" in
        Darwin) _os="macos" ;;
        Linux)  _os="linux" ;;
        *)
            printf ''
            return 1
            ;;
    esac
    case "${_mach}" in
        x86_64|amd64|AMD64) _arch="x86_64" ;;
        arm64|aarch64|ARM64) _arch="aarch64" ;;
        *)
            printf ''
            return 1
            ;;
    esac
    if [ "${_os}" = "macos" ] && [ "${_arch}" = "x86_64" ]; then
        _sysctl=$(command -v sysctl 2>/dev/null || echo /usr/sbin/sysctl)
        if [ "$("${_sysctl}" -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
            _arch="aarch64"
        fi
    fi
    printf '%s-%s' "${_os}" "${_arch}"
    return 0
}

# =============================================================================
# gc_setup_elf_arch() - Class B: print x86_64 / aarch64 from ELF e_machine
# =============================================================================
#
# GENERAL PURPOSE:
# Read ELF magic and e_machine (offset 18, little-endian u16) so setup can
# refuse a linux-x86_64 grok on aarch64 Termux before exec. Empty + return 1
# when the file is not ELF, od/dd cannot read it, or the machine is unknown.
# Scripts used in Core tests are not ELF — callers MUST treat empty as
# "skip this check", not as a match.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_elf_arch() {
    _gea_file="${1:-}"
    if [ -z "${_gea_file}" ] || [ ! -f "${_gea_file}" ]; then
        printf ''
        return 1
    fi
    if ! command -v od >/dev/null 2>&1; then
        printf ''
        return 1
    fi
    _gea_magic=$(od -An -N 4 -t x1 "${_gea_file}" 2>/dev/null | tr -d ' \n\t' | tr 'A-F' 'a-f')
    if [ "${_gea_magic}" != "7f454c46" ]; then
        printf ''
        return 1
    fi
    _gea_mach=$(od -An -N 2 -j 18 -t u2 "${_gea_file}" 2>/dev/null | tr -d ' \n\t')
    if [ -z "${_gea_mach}" ] && command -v dd >/dev/null 2>&1; then
        _gea_mach=$(dd if="${_gea_file}" bs=1 skip=18 count=2 2>/dev/null | od -An -t u2 | tr -d ' \n\t')
    fi
    case "${_gea_mach}" in
        62) printf 'x86_64' ;;
        183) printf 'aarch64' ;;
        *)
            printf ''
            return 1
            ;;
    esac
    return 0
}

# =============================================================================
# gc_setup_peer_usable() - 0 if existing grok can run on this host
# =============================================================================
#
# GENERAL PURPOSE:
# Skip setup only when the peer is actually usable here. An x86_64 ELF
# copied onto aarch64 Termux is executable-bit-on and must not count as
# already_installed. Prefer ELF e_machine over exec when both are known
# so Termux does not print EM_X86_64 during the probe.
#
# $1 = peer path; $2 = host arch (x86_64 / aarch64, may be empty).
# Sets GC_SETUP_PEER_UNUSABLE on failure.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_peer_usable() {
    _gpu_peer="${1:-}"
    _gpu_host_arch="${2:-}"
    GC_SETUP_PEER_UNUSABLE=""
    if [ -z "${_gpu_peer}" ] || [ ! -x "${_gpu_peer}" ]; then
        GC_SETUP_PEER_UNUSABLE="not executable"
        return 1
    fi
    _gpu_elf=$(gc_setup_elf_arch "${_gpu_peer}") || _gpu_elf=""
    if [ -n "${_gpu_elf}" ] && [ -n "${_gpu_host_arch}" ] && [ "${_gpu_elf}" != "${_gpu_host_arch}" ]; then
        GC_SETUP_PEER_UNUSABLE="${_gpu_elf} ELF, this host is ${_gpu_host_arch}"
        return 1
    fi
    if gc_setup_smoke_version "${_gpu_peer}"; then
        return 0
    fi
    GC_SETUP_PEER_UNUSABLE="failed --version"
    if [ -n "${GC_SETUP_SMOKE_DETAIL:-}" ]; then
        GC_SETUP_PEER_UNUSABLE="${GC_SETUP_PEER_UNUSABLE} (${GC_SETUP_SMOKE_DETAIL})"
    fi
    return 1
}

# =============================================================================
# gc_setup_curl_file() - curl URL into a file; 0 only when HTTP 200 and non-empty
# =============================================================================
#
# GENERAL PURPOSE:
# Fetch one URL into a dest file. Record GC_SETUP_CURL_HTTP and
# GC_SETUP_CURL_DETAIL so setup errors can name HTTP 404 / HTTP 000
# instead of only "check network". Does not use curl -f, so the
# status code is still available on 4xx/5xx.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_curl_file() {
    _gcf_url="${1:-}"
    _gcf_out="${2:-}"
    GC_SETUP_CURL_HTTP=""
    GC_SETUP_CURL_DETAIL=""
    if [ -z "${_gcf_url}" ] || [ -z "${_gcf_out}" ]; then
        GC_SETUP_CURL_DETAIL="missing URL or dest"
        return 1
    fi
    GC_SETUP_CURL_URL="${_gcf_url}"
    _gcf_ec=0
    _gcf_code=$(curl -sS -L -o "${_gcf_out}" -w '%{http_code}' "${_gcf_url}" 2>/dev/null) || _gcf_ec=$?
    GC_SETUP_CURL_HTTP="${_gcf_code}"
    if [ "${_gcf_ec}" -ne 0 ]; then
        if [ -n "${_gcf_code}" ] && [ "${_gcf_code}" != "000" ]; then
            GC_SETUP_CURL_DETAIL="HTTP ${_gcf_code} (curl exit ${_gcf_ec})"
        else
            GC_SETUP_CURL_DETAIL="HTTP 000 (curl exit ${_gcf_ec})"
        fi
        unset _gcf_url _gcf_out _gcf_code _gcf_ec
        return 1
    fi
    if [ -z "${_gcf_code}" ]; then
        GC_SETUP_CURL_DETAIL="curl returned no HTTP status"
        unset _gcf_url _gcf_out _gcf_code _gcf_ec
        return 1
    fi
    if [ "${_gcf_code}" != "200" ]; then
        GC_SETUP_CURL_DETAIL="HTTP ${_gcf_code}"
        unset _gcf_url _gcf_out _gcf_code _gcf_ec
        return 1
    fi
    if [ ! -s "${_gcf_out}" ]; then
        GC_SETUP_CURL_DETAIL="HTTP ${_gcf_code} empty body"
        unset _gcf_url _gcf_out _gcf_code _gcf_ec
        return 1
    fi
    unset _gcf_url _gcf_out _gcf_code _gcf_ec
    return 0
}

# =============================================================================
# gc_setup_read_pointer() - set GC_SETUP_POINTER from channel (same shell)
# =============================================================================
gc_setup_read_pointer() {
    _grp_channel="${1:-stable}"
    GC_SETUP_POINTER=""
    : "${GROK_VENDOR_BASE_URL:=https://x.ai/cli}"
    : "${GROK_VENDOR_FALLBACK_URL:=https://storage.googleapis.com/grok-build-public-artifacts/cli}"
    _grp_tmp=$(util_mktemp ptr)
    if [ -z "${_grp_tmp}" ]; then
        return 1
    fi
    for _grp_base in "${GROK_VENDOR_BASE_URL}" "${GROK_VENDOR_FALLBACK_URL}"; do
        if gc_setup_curl_file "${_grp_base}/${_grp_channel}" "${_grp_tmp}"; then
            _grp_ver=$(tr -d '\r' < "${_grp_tmp}" | head -n1 | tr -d '[:space:]')
            if gc_setup_version_ok "${_grp_ver}"; then
                rm -f "${_grp_tmp}"
                GC_SETUP_POINTER="${_grp_ver}"
                unset _grp_channel _grp_tmp _grp_base _grp_ver
                return 0
            fi
            GC_SETUP_CURL_DETAIL="HTTP ${GC_SETUP_CURL_HTTP:-?} invalid version pointer"
        fi
    done
    rm -f "${_grp_tmp}"
    unset _grp_channel _grp_tmp _grp_base _grp_ver
    return 1
}

# =============================================================================
# gc_setup_fetch_binary_from() - one artifact base (.zst / .gz / raw) → dest
# =============================================================================
gc_setup_fetch_binary_from() {
    _gfb_art="${1:-}"
    _gfb_dest="${2:-}"
    _gfb_tmp=$(util_mktemp setupz)
    if [ -z "${_gfb_tmp}" ]; then
        return 1
    fi
    if command -v zstd >/dev/null 2>&1; then
        if gc_setup_curl_file "${_gfb_art}.zst" "${_gfb_tmp}"; then
            if zstd -q -dc < "${_gfb_tmp}" > "${_gfb_dest}" 2>/dev/null && [ -s "${_gfb_dest}" ]; then
                rm -f "${_gfb_tmp}"
                return 0
            fi
        fi
        rm -f "${_gfb_dest}"
    fi
    if command -v gzip >/dev/null 2>&1; then
        if gc_setup_curl_file "${_gfb_art}.gz" "${_gfb_tmp}"; then
            if gzip -dc < "${_gfb_tmp}" > "${_gfb_dest}" 2>/dev/null && [ -s "${_gfb_dest}" ]; then
                rm -f "${_gfb_tmp}"
                return 0
            fi
        fi
        rm -f "${_gfb_dest}"
    fi
    rm -f "${_gfb_tmp}"
    if gc_setup_curl_file "${_gfb_art}" "${_gfb_dest}"; then
        return 0
    fi
    rm -f "${_gfb_dest}"
    return 1
}

# =============================================================================
# gc_setup_fetch_artifact() - primary then fallback bases
# =============================================================================
gc_setup_fetch_artifact() {
    _gfa_version="${1:-}"
    _gfa_platform="${2:-}"
    _gfa_dest="${3:-}"
    : "${GROK_VENDOR_BASE_URL:=https://x.ai/cli}"
    : "${GROK_VENDOR_FALLBACK_URL:=https://storage.googleapis.com/grok-build-public-artifacts/cli}"
    for _gfa_base in "${GROK_VENDOR_BASE_URL}" "${GROK_VENDOR_FALLBACK_URL}"; do
        if gc_setup_fetch_binary_from "${_gfa_base}/grok-${_gfa_version}-${_gfa_platform}" "${_gfa_dest}"; then
            return 0
        fi
    done
    return 1
}

# =============================================================================
# gc_setup_place_links() - downloads file + relative grok/agent symlinks
# =============================================================================
gc_setup_place_links() {
    _gpl_src="${1:-}"
    _gpl_download_dir="${2:-}"
    _gpl_bin_dir="${3:-}"
    _gpl_platform="${4:-}"
    _gpl_final="${_gpl_download_dir}/grok-${_gpl_platform}"
    mkdir -p "${_gpl_download_dir}" "${_gpl_bin_dir}" || return 1
    mv -f "${_gpl_src}" "${_gpl_final}" || return 1
    chmod 0755 "${_gpl_final}" || return 1
    if [ "$(dirname "${_gpl_bin_dir}")" = "$(dirname "${_gpl_download_dir}")" ]; then
        _gpl_link="../$(basename "${_gpl_download_dir}")/$(basename "${_gpl_final}")"
    else
        _gpl_link="${_gpl_final}"
    fi
    ln -sf "${_gpl_link}" "${_gpl_bin_dir}/grok" || return 1
    ln -sf "${_gpl_link}" "${_gpl_bin_dir}/agent" || return 1
    return 0
}

# =============================================================================
# gc_setup_path_symlink() - link into a writable PATH dir (USER_BIN, GLOBAL_BIN, PREFIX)
# =============================================================================
gc_setup_path_symlink() {
    _gps_bin_dir="${1:-}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    for _gps_cand in "${USER_BIN}" "${GLOBAL_BIN}" ${PREFIX:+"${PREFIX}/bin"}; do
        [ -n "${_gps_cand}" ] || continue
        if gc_setup_path_has_dir "${_gps_cand}" && [ -d "${_gps_cand}" ] && [ -w "${_gps_cand}" ]; then
            ln -sf "${_gps_bin_dir}/grok" "${_gps_cand}/grok" 2>/dev/null || true
            ln -sf "${_gps_bin_dir}/agent" "${_gps_cand}/agent" 2>/dev/null || true
            return 0
        fi
    done
    return 0
}

# =============================================================================
# gc_setup_host_is_android() - 0 when uname reports Android (Termux)
# =============================================================================
#
# ALIGNMENT: requirement-shell-termux-coding.md · requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_host_is_android() {
    case "$(uname -a 2>/dev/null) $(uname -o 2>/dev/null)" in
        *Android*) return 0 ;;
    esac
    return 1
}

# =============================================================================
# gc_setup_termux_exec_off() - unset Termux LD_PRELOAD for one exec
# =============================================================================
#
# GENERAL PURPOSE:
# termux-exec (LD_PRELOAD) rewrites execve through linker64, which
# refuses ET_EXEC. Save and clear it; pair with gc_setup_termux_exec_restore.
# Also used before proot (Termux wiki: proot under libtermux-exec fails).
#
# ALIGNMENT: requirement-grok-setup.md · requirement-shell-termux-coding.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_termux_exec_off() {
    GC_SETUP_LD_SET=0
    if [ "${LD_PRELOAD+x}" = "x" ]; then
        GC_SETUP_LD_SET=1
        GC_SETUP_LD="${LD_PRELOAD}"
    fi
    GC_SETUP_OPT_SET=0
    if [ "${TERMUX_EXEC_OPTOUT+x}" = "x" ]; then
        GC_SETUP_OPT_SET=1
        GC_SETUP_OPT="${TERMUX_EXEC_OPTOUT}"
    fi
    unset LD_PRELOAD
    TERMUX_EXEC_OPTOUT=1
    export TERMUX_EXEC_OPTOUT
    return 0
}

# =============================================================================
# gc_setup_termux_exec_restore() - restore LD_PRELOAD after a smoke exec
# =============================================================================
gc_setup_termux_exec_restore() {
    if [ "${GC_SETUP_LD_SET:-0}" -eq 1 ]; then
        LD_PRELOAD="${GC_SETUP_LD}"
        export LD_PRELOAD
    fi
    if [ "${GC_SETUP_OPT_SET:-0}" -eq 1 ]; then
        TERMUX_EXEC_OPTOUT="${GC_SETUP_OPT}"
        export TERMUX_EXEC_OPTOUT
    else
        unset TERMUX_EXEC_OPTOUT
    fi
    return 0
}

# =============================================================================
# gc_setup_keep_failed_download() - leave smoked file as grok-*.failed
# =============================================================================
#
# GENERAL PURPOSE:
# On Android ET_EXEC refusal, do not rm the mktemp sibling. Rename it
# to downloads/grok-{{os}}-{{arch}}.failed so ls ~/.grok/downloads shows it.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_keep_failed_download() {
    _gkf_src="${1:-}"
    _gkf_dir="${2:-}"
    _gkf_plat="${3:-}"
    GC_SETUP_FAILED_PATH=""
    if [ -z "${_gkf_src}" ] || [ ! -f "${_gkf_src}" ] || [ -z "${_gkf_dir}" ] || [ -z "${_gkf_plat}" ]; then
        return 1
    fi
    _gkf_dest="${_gkf_dir}/grok-${_gkf_plat}.failed"
    mv -f "${_gkf_src}" "${_gkf_dest}" || return 1
    chmod 0755 "${_gkf_dest}" 2>/dev/null || true
    GC_SETUP_FAILED_PATH="${_gkf_dest}"
    unset _gkf_src _gkf_dir _gkf_plat _gkf_dest
    return 0
}

# =============================================================================
# gc_setup_smoke_version() - exec downloaded grok --version (class B)
# =============================================================================
#
# GENERAL PURPOSE:
# Smoke the artifact in place. On failure, set GC_SETUP_SMOKE_DETAIL to a
# short "exit N: stderr" line for the operator error. Cache/tmp may be
# noexec; the caller MUST pass a path under GROK_HOME/downloads.
# $2 = direct (default) | optout | proot. optout unsets LD_PRELOAD and
# sets TERMUX_EXEC_OPTOUT so Termux does not load ET_EXEC via linker64.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_smoke_version() {
    _gsv_bin="${1:-}"
    _gsv_how="${2:-direct}"
    GC_SETUP_SMOKE_DETAIL=""
    if [ -z "${_gsv_bin}" ] || [ ! -f "${_gsv_bin}" ]; then
        GC_SETUP_SMOKE_DETAIL="file missing"
        return 1
    fi
    _gsv_out=$(util_mktemp smokeout)
    if [ -z "${_gsv_out}" ]; then
        GC_SETUP_SMOKE_DETAIL="could not capture smoke output"
        return 1
    fi
    _gsv_ec=1
    case "${_gsv_how}" in
        optout)
            gc_setup_termux_exec_off
            "${_gsv_bin}" --version </dev/null >"${_gsv_out}" 2>&1
            _gsv_ec=$?
            gc_setup_termux_exec_restore
            ;;
        proot)
            _gsv_proot=$(command -v proot 2>/dev/null || true)
            if [ -z "${_gsv_proot}" ]; then
                rm -f "${_gsv_out}"
                GC_SETUP_SMOKE_DETAIL="proot not on PATH"
                unset _gsv_bin _gsv_how _gsv_out _gsv_ec _gsv_proot
                return 1
            fi
            gc_setup_termux_exec_off
            "${_gsv_proot}" "${_gsv_bin}" --version </dev/null >"${_gsv_out}" 2>&1
            _gsv_ec=$?
            gc_setup_termux_exec_restore
            ;;
        *)
            "${_gsv_bin}" --version </dev/null >"${_gsv_out}" 2>&1
            _gsv_ec=$?
            ;;
    esac
    if [ "${_gsv_ec}" -eq 0 ]; then
        rm -f "${_gsv_out}"
        unset _gsv_bin _gsv_how _gsv_out _gsv_ec _gsv_ld_set _gsv_ld _gsv_opt_set _gsv_opt _gsv_proot
        return 0
    fi
    _gsv_txt=$(tr '\n' ' ' < "${_gsv_out}" 2>/dev/null | cut -c1-200)
    rm -f "${_gsv_out}"
    GC_SETUP_SMOKE_DETAIL="exit ${_gsv_ec}"
    if [ -n "${_gsv_txt}" ]; then
        GC_SETUP_SMOKE_DETAIL="${GC_SETUP_SMOKE_DETAIL}: ${_gsv_txt}"
    fi
    unset _gsv_bin _gsv_how _gsv_out _gsv_ec _gsv_txt _gsv_ld_set _gsv_ld _gsv_opt_set _gsv_opt _gsv_proot
    return 1
}

# =============================================================================
# gc_setup_ensure_termux_proot() - Type 0: pkg install -y proot on Termux
# =============================================================================
#
# GENERAL PURPOSE:
# When Android/Termux cannot exec the vendor grok and proot is missing,
# install it with Termux pkg (no sudo, -y, stdin closed). MUST NOT run
# pkg on non-Android (FreeBSD pkg is a different tool). A failed install
# is not a setup fatal — caller retries smoke and uses the e_type Next.
#
# ALIGNMENT: requirement-grok-setup.md · requirement-shell-termux-coding.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_ensure_termux_proot() {
    : "${APP_NAME:=grok-cli}"
    if command -v proot >/dev/null 2>&1; then
        return 0
    fi
    if ! gc_setup_host_is_android; then
        return 1
    fi
    _gep_pkg=""
    if [ -n "${PREFIX:-}" ] && [ -x "${PREFIX}/bin/pkg" ]; then
        _gep_pkg="${PREFIX}/bin/pkg"
    else
        _gep_pkg=$(command -v pkg 2>/dev/null || true)
    fi
    if [ -z "${_gep_pkg}" ]; then
        unset _gep_pkg
        return 1
    fi
    out_info "This Termux host needs proot to run grok. Installing proot with pkg install -y proot."
    _gep_df_set=0
    if [ "${DEBIAN_FRONTEND+x}" = "x" ]; then
        _gep_df_set=1
        _gep_df="${DEBIAN_FRONTEND}"
    fi
    DEBIAN_FRONTEND=noninteractive
    export DEBIAN_FRONTEND
    _gep_pkg_out=$(util_mktemp pkgout)
    "${_gep_pkg}" install -y proot </dev/null >"${_gep_pkg_out}" 2>&1
    _gep_pkg_ec=$?
    if [ "${_gep_pkg_ec}" -ne 0 ]; then
        _gep_snip=$(tr '\n' ' ' < "${_gep_pkg_out}" 2>/dev/null | cut -c1-200)
        rm -f "${_gep_pkg_out}"
        if [ -n "${_gep_snip}" ]; then
            out_warn "pkg install -y proot failed (exit ${_gep_pkg_ec}: ${_gep_snip}). Continuing without a new proot."
        else
            out_warn "pkg install -y proot failed (exit ${_gep_pkg_ec}). Continuing without a new proot."
        fi
    else
        rm -f "${_gep_pkg_out}"
    fi
    if [ "${_gep_df_set}" -eq 1 ]; then
        DEBIAN_FRONTEND="${_gep_df}"
        export DEBIAN_FRONTEND
    else
        unset DEBIAN_FRONTEND
    fi
    if [ -n "${PREFIX:-}" ] && [ -x "${PREFIX}/bin/proot" ]; then
        case ":${PATH}:" in
            *":${PREFIX}/bin:"*) ;;
            *)
                PATH="${PREFIX}/bin:${PATH}"
                export PATH
                ;;
        esac
    fi
    unset _gep_pkg _gep_df_set _gep_df
    if command -v proot >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

# =============================================================================
# gc_setup_smoke_android() - retry --version via Termux opt-out or proot
# =============================================================================
#
# GENERAL PURPOSE:
# Direct exec of xAI's linux-aarch64 grok fails on many Termux hosts
# (Android linker64: unexpected e_type 2 / ET_EXEC). Retry without
# libtermux-exec; if that fails and proot is missing, pkg install -y
# proot on Termux, then smoke via proot. Sets GC_SETUP_SMOKE_METHOD
# on success. MUST NOT byte-patch the vendor file.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_smoke_android() {
    _gsa_bin="${1:-}"
    GC_SETUP_SMOKE_METHOD=""
    if gc_setup_smoke_version "${_gsa_bin}" optout; then
        GC_SETUP_SMOKE_METHOD="optout"
        unset _gsa_bin
        return 0
    fi
    if ! command -v proot >/dev/null 2>&1; then
        gc_setup_ensure_termux_proot
    fi
    if command -v proot >/dev/null 2>&1; then
        if gc_setup_smoke_version "${_gsa_bin}" proot; then
            GC_SETUP_SMOKE_METHOD="proot"
            unset _gsa_bin
            return 0
        fi
    fi
    unset _gsa_bin
    return 1
}

# =============================================================================
# gc_setup_write_exec_wrapper() - POSIX launcher for Android ET_EXEC grok
# =============================================================================
#
# GENERAL PURPOSE:
# Write bin/grok as a small /bin/sh wrapper that execs the unmodified
# vendor file with TERMUX_EXEC_OPTOUT or proot. Absolute vendor path so
# ~/.local/bin/grok → ~/.grok/bin/grok still finds downloads/.
# proot wrappers pass --kill-on-exit when advertised (never -k:
# that is --kernel-release). Headless -p/--single injects
# --no-auto-update and SIGKILLs the child on Ctrl-C so grok -p
# returns to the shell (vendor grok under proot often prints then
# ignores SIGINT; Ctrl-Z is not an acceptable close). Interactive
# grok still execs so the TUI owns the TTY.
#
# $1 = wrapper path; $2 = vendor file; $3 = optout | proot
# $4 = optional resolv.conf to bind at /etc/resolv.conf via proot -b
#
# ALIGNMENT: requirement-grok-setup.md
#
# Lessons Learned (CIAO Reflection):
# 2026-09-07: grok -p hello on Termux printed the answer then hung
# until Ctrl-Z. grok-cli menu was already bounded (1.8.14); the
# operator-facing wrapper still exec'd proot without --kill-on-exit
# and did not SIGKILL on INT. INC-20260907-002.
#
# Last updated: 2026-09-07
# =============================================================================
gc_setup_write_exec_wrapper() {
    _gew_path="${1:-}"
    _gew_vendor="${2:-}"
    _gew_method="${3:-optout}"
    _gew_resolv="${4:-}"
    if [ -z "${_gew_path}" ] || [ -z "${_gew_vendor}" ]; then
        return 1
    fi
    case "${_gew_vendor}" in
        *"'"*)
            if ! command -v sed >/dev/null 2>&1; then
                unset _gew_path _gew_vendor _gew_method
                return 1
            fi
            _gew_q="'$(printf '%s' "${_gew_vendor}" | sed "s/'/'\\\\''/g")'"
            ;;
        *)
            _gew_q="'${_gew_vendor}'"
            ;;
    esac
    if [ "${_gew_method}" = "proot" ]; then
        _gew_bind=""
        if [ -n "${_gew_resolv}" ]; then
            case "${_gew_resolv}" in
                *"'"*)
                    if command -v sed >/dev/null 2>&1; then
                        _gew_rq="'$(printf '%s' "${_gew_resolv}" | sed "s/'/'\\\\''/g")'"
                    else
                        _gew_rq="'${_gew_resolv}'"
                    fi
                    ;;
                *)
                    _gew_rq="'${_gew_resolv}'"
                    ;;
            esac
            _gew_bind="-b ${_gew_rq}:/etc/resolv.conf "
        fi
        cat > "${_gew_path}" <<EOF
#!/bin/sh
unset LD_PRELOAD
TERMUX_EXEC_OPTOUT=1
export TERMUX_EXEC_OPTOUT
_g=${_gew_q}
_p=\$(command -v proot 2>/dev/null || true)
if [ -z "\${_p}" ]; then
  printf '%s\\n' "proot is not on PATH, so grok cannot run on this Android host. Next: pkg install proot" >&2
  exit 127
fi
_k=""
if command -v grep >/dev/null 2>&1; then
  if "\${_p}" --help 2>&1 | grep -q kill-on-exit; then
    _k="--kill-on-exit"
  fi
fi
_pflag=0
_nau=""
for _a in "\$@"; do
  case "\${_a}" in
    -p|--single|--prompt-file|--prompt-json) _pflag=1 ;;
    --no-auto-update) _nau="have" ;;
  esac
done
if [ "\${_pflag}" -eq 1 ] && [ "\${_nau}" != "have" ]; then
  _nau="--no-auto-update"
else
  _nau=""
fi
if [ "\${_pflag}" -eq 1 ]; then
  # grok-cli proot-exit-reaper
  # Guest already exited; PRoot cannot determine that (do_wait).
  # Match args/exe, not truncated comm. Reap only NEW runsvdir.
  _tmp="\${TMPDIR:-\${TMP:-/tmp}}"
  _out=\$(mktemp "\${_tmp}/grok-p-out.XXXXXX") || exit 1
  _err=\$(mktemp "\${_tmp}/grok-p-err.XXXXXX") || exit 1
  _before=\$(mktemp "\${_tmp}/grok-p-rsv.XXXXXX") || exit 1
  ps -eo pid= -o args= 2>/dev/null | awk '
    \$2 ~ /\\/runsvdir\$/ || \$2 == "runsvdir" { print \$1 }
  ' | sort >"\${_before}" 2>/dev/null || :
  trap '
    if [ -n "\${_pid:-}" ]; then
      kill -TERM "\${_pid}" 2>/dev/null || true
      sleep 1
      kill -KILL "\${_pid}" 2>/dev/null || true
    fi
    rm -f "\${_out}" "\${_err}" "\${_before}"
    exit 130
  ' INT TERM
  "\${_p}" \${_k} ${_gew_bind}"\${_g}" \${_nau} "\$@" >"\${_out}" 2>"\${_err}" &
  _pid=\$!
  (
    _seen=0
    _osize=0
    _idle_since=0
    _start=\$(date +%s)
    while :; do
      _now=\$(date +%s)
      if [ \$((_now - _start)) -ge 180 ]; then
        break
      fi
      if ! kill -0 "\${_pid}" 2>/dev/null; then
        exit 0
      fi
      _child=\$(ps -eo pid= -o ppid= -o args= 2>/dev/null | awk -v pp="\${_pid}" '
        \$2 == pp && (\$3 ~ /\\/grok-linux/ || \$3 ~ /grok-linux/) {
          print \$1
          exit
        }
      ')
      if [ -n "\${_child}" ]; then
        _seen=1
      elif [ "\${_seen}" -eq 1 ]; then
        break
      fi
      _sz=\$(wc -c <"\${_out}" 2>/dev/null | tr -d ' \\t\\n')
      _sz=\${_sz:-0}
      if [ "\${_sz}" -gt 0 ]; then
        if [ "\${_sz}" -ne "\${_osize}" ]; then
          _osize=\${_sz}
          _idle_since=\${_now}
        elif [ "\${_idle_since}" -gt 0 ] && [ \$((_now - _idle_since)) -ge 1 ]; then
          break
        fi
      fi
      sleep 1
    done
    ps -eo pid= -o args= 2>/dev/null | awk '
      \$2 ~ /\\/runsvdir\$/ || \$2 == "runsvdir" { print \$1 }
    ' | sort | while read -r _rpid; do
      [ -n "\${_rpid}" ] || continue
      if ! grep -qx "\${_rpid}" "\${_before}" 2>/dev/null; then
        kill "\${_rpid}" 2>/dev/null || :
      fi
    done
    _dl=\$(( \$(date +%s) + 2 ))
    while [ "\$(date +%s)" -lt "\${_dl}" ]; do
      kill -0 "\${_pid}" 2>/dev/null || exit 0
      sleep 1
    done
    kill "\${_pid}" 2>/dev/null || :
    sleep 1
    kill -KILL "\${_pid}" 2>/dev/null || :
    exit 0
  ) &
  _reaper=\$!
  wait "\${_pid}" 2>/dev/null || :
  wait "\${_reaper}" 2>/dev/null || :
  trap - INT TERM
  if [ -s "\${_err}" ]; then
    cat "\${_err}" >&2
  fi
  if [ -s "\${_out}" ]; then
    cat "\${_out}"
    rm -f "\${_out}" "\${_err}" "\${_before}"
    exit 0
  fi
  rm -f "\${_out}" "\${_err}" "\${_before}"
  exit 1
fi
exec "\${_p}" \${_k} ${_gew_bind}"\${_g}" "\$@"
EOF
    else
        cat > "${_gew_path}" <<EOF
#!/bin/sh
unset LD_PRELOAD
TERMUX_EXEC_OPTOUT=1
export TERMUX_EXEC_OPTOUT
_pflag=0
_nau=""
for _a in "\$@"; do
  case "\${_a}" in
    -p|--single|--prompt-file|--prompt-json) _pflag=1 ;;
    --no-auto-update) _nau="have" ;;
  esac
done
if [ "\${_pflag}" -eq 1 ] && [ "\${_nau}" != "have" ]; then
  _nau="--no-auto-update"
else
  _nau=""
fi
if [ "\${_pflag}" -eq 1 ]; then
  trap '
    if [ -n "\${_pid:-}" ]; then
      kill -TERM "\${_pid}" 2>/dev/null || true
      sleep 1
      kill -KILL "\${_pid}" 2>/dev/null || true
    fi
    exit 130
  ' INT TERM
  ${_gew_q} \${_nau} "\$@" &
  _pid=\$!
  wait "\${_pid}"
  _ec=\$?
  trap - INT TERM
  exit "\${_ec}"
fi
exec ${_gew_q} "\$@"
EOF
    fi
    if [ ! -s "${_gew_path}" ]; then
        unset _gew_path _gew_vendor _gew_method _gew_q
        return 1
    fi
    chmod 0755 "${_gew_path}" || return 1
    unset _gew_path _gew_vendor _gew_method _gew_q _gew_resolv _gew_bind _gew_rq
    return 0
}

# =============================================================================
# gc_setup_place_android_wrapper() - vendor file + POSIX grok/agent wrapper
# =============================================================================
#
# GENERAL PURPOSE:
# Move the smoked download into downloads/grok-{{os}}-{{arch}} and write
# bin/grok as an exec wrapper (rule 18c). Does not patch vendor bytes.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_place_android_wrapper() {
    _gpa_src="${1:-}"
    _gpa_download_dir="${2:-}"
    _gpa_bin_dir="${3:-}"
    _gpa_platform="${4:-}"
    _gpa_method="${5:-optout}"
    _gpa_final="${_gpa_download_dir}/grok-${_gpa_platform}"
    mkdir -p "${_gpa_download_dir}" "${_gpa_bin_dir}" || return 1
    mv -f "${_gpa_src}" "${_gpa_final}" || return 1
    chmod 0755 "${_gpa_final}" || return 1
    if ! gc_setup_write_exec_wrapper "${_gpa_bin_dir}/grok" "${_gpa_final}" "${_gpa_method}"; then
        return 1
    fi
    ln -sf grok "${_gpa_bin_dir}/agent" || return 1
    unset _gpa_src _gpa_download_dir _gpa_bin_dir _gpa_platform _gpa_method _gpa_final
    return 0
}

# =============================================================================
# gc_setup_heal_android_wrapper() - rewrite a stale Termux grok wrapper
# =============================================================================
#
# GENERAL PURPOSE:
# When grok already runs, setup skips the download. An older POSIX
# wrapper (exec proot, no --kill-on-exit, no -p SIGKILL) still hangs
# after grok -p prints. Rewrite bin/grok from the existing vendor file
# with no network. No-op when not Android, not a wrapper, or already
# current. Does not byte-patch the vendor file.
#
# $1 = peer path (bin/grok)
#
# ALIGNMENT: requirement-grok-setup.md
#
# Lessons Learned (CIAO Reflection):
# 2026-09-07: operators who already had grok installed would never get
# the hang fix without --force (a full re-download). Heal on skip.
# INC-20260907-002.
#
# Last updated: 2026-09-07
# =============================================================================
gc_setup_heal_android_wrapper() {
    : "${APP_NAME:=grok-cli}"
    GC_SETUP_WRAPPER_HEALED=0
    _haw_peer="${1:-}"
    if [ -z "${_haw_peer}" ] || [ ! -f "${_haw_peer}" ]; then
        unset _haw_peer
        return 0
    fi
    if ! gc_setup_host_is_android; then
        unset _haw_peer
        return 0
    fi
    _haw_head=$(head -n1 "${_haw_peer}" 2>/dev/null || true)
    case "${_haw_head}" in
        "#!/bin/sh"|"#!/bin/sh ") ;;
        *)
            unset _haw_peer _haw_head
            return 0
            ;;
    esac
    if grep -q kill-on-exit "${_haw_peer}" 2>/dev/null; then
        if grep -q no-auto-update "${_haw_peer}" 2>/dev/null; then
            if grep -q proot-exit-reaper "${_haw_peer}" 2>/dev/null; then
                unset _haw_peer _haw_head
                return 0
            fi
        fi
    fi
    _haw_g=$(grep '^_g=' "${_haw_peer}" 2>/dev/null | head -n1 | sed "s/^_g=//; s/^'//; s/'\$//")
    _haw_method="optout"
    if grep -q 'command -v proot' "${_haw_peer}" 2>/dev/null; then
        _haw_method="proot"
    fi
    if [ -z "${_haw_g}" ] || [ ! -f "${_haw_g}" ]; then
        _haw_home=$(gc_resolve_grok_home)
        _haw_plat=$(gc_setup_detect_platform) || _haw_plat=""
        if [ -n "${_haw_plat}" ] && [ -f "${_haw_home}/downloads/grok-${_haw_plat}" ]; then
            _haw_g="${_haw_home}/downloads/grok-${_haw_plat}"
        fi
    fi
    if [ -z "${_haw_g}" ] || [ ! -f "${_haw_g}" ]; then
        unset _haw_peer _haw_head _haw_g _haw_method _haw_home _haw_plat
        return 0
    fi
    _haw_home=$(gc_resolve_grok_home)
    _haw_resolv=""
    if [ -s "${_haw_home}/resolv.conf" ]; then
        _haw_resolv="${_haw_home}/resolv.conf"
    fi
    _haw_dir=$(dirname "${_haw_peer}")
    if gc_setup_write_exec_wrapper "${_haw_peer}" "${_haw_g}" "${_haw_method}" "${_haw_resolv}"; then
        ln -sf grok "${_haw_dir}/agent" 2>/dev/null || true
        out_info "Rewrote ${_haw_peer} so grok -p can exit (proot-exit-reaper; vendor binary unchanged). Next: grok -p hello"
        GC_SETUP_WRAPPER_HEALED=1
    fi
    unset _haw_peer _haw_head _haw_g _haw_method _haw_home _haw_plat _haw_resolv _haw_dir
    return 0
}

# =============================================================================
# gc_setup_host_resolv_ok() - 0 if probe resolv has a nameserver line
# =============================================================================
gc_setup_host_resolv_ok() {
    : "${GROK_SETUP_RESOLV_FILE:=/etc/resolv.conf}"
    if [ -s "${GROK_SETUP_RESOLV_FILE}" ] && grep -q '^nameserver' "${GROK_SETUP_RESOLV_FILE}" 2>/dev/null; then
        return 0
    fi
    return 1
}

# =============================================================================
# gc_setup_write_resolv_conf() - nameserver file for musl via proot bind
# =============================================================================
#
# GENERAL PURPOSE:
# Static vendor grok (musl) reads /etc/resolv.conf. Termux /etc has no
# nameserver. Write GROK_HOME/resolv.conf without patching the binary.
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_write_resolv_conf() {
    _grc_dest="${1:-}"
    if [ -z "${_grc_dest}" ]; then
        return 1
    fi
    _grc_tmp=$(util_mktemp resolv)
    if [ -z "${_grc_tmp}" ]; then
        return 1
    fi
    : > "${_grc_tmp}"
    if [ -n "${PREFIX:-}" ] && [ -f "${PREFIX}/etc/resolv.conf" ]; then
        grep '^nameserver' "${PREFIX}/etc/resolv.conf" >> "${_grc_tmp}" 2>/dev/null || true
    fi
    if ! grep -q '^nameserver' "${_grc_tmp}" 2>/dev/null; then
        if command -v getprop >/dev/null 2>&1; then
            _grc_d1=$(getprop net.dns1 2>/dev/null || true)
            _grc_d2=$(getprop net.dns2 2>/dev/null || true)
            if [ -n "${_grc_d1}" ]; then
                printf 'nameserver %s\n' "${_grc_d1}" >> "${_grc_tmp}"
            fi
            if [ -n "${_grc_d2}" ]; then
                printf 'nameserver %s\n' "${_grc_d2}" >> "${_grc_tmp}"
            fi
        fi
    fi
    if ! grep -q '^nameserver' "${_grc_tmp}" 2>/dev/null; then
        printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >> "${_grc_tmp}"
    fi
    mv -f "${_grc_tmp}" "${_grc_dest}" || return 1
    chmod 0644 "${_grc_dest}" 2>/dev/null || true
    unset _grc_dest _grc_tmp _grc_d1 _grc_d2
    return 0
}

# =============================================================================
# gc_setup_maybe_android_dns() - bind GROK_HOME/resolv.conf via proot
# =============================================================================
#
# GENERAL PURPOSE:
# After Android place, if the host resolv probe has no nameserver, write
# a resolv file and rewrite bin/grok to proot -b that file over
# /etc/resolv.conf so grok login can resolve auth.x.ai.
#
# $1 = vendor file; $2 = bin dir; $3 = grok home
#
# ALIGNMENT: requirement-grok-setup.md
# Last updated: 2026-09-04
# =============================================================================
gc_setup_maybe_android_dns() {
    _gad_vendor="${1:-}"
    _gad_bin_dir="${2:-}"
    _gad_home="${3:-}"
    : "${APP_NAME:=grok-cli}"
    if [ -z "${_gad_vendor}" ] || [ ! -f "${_gad_vendor}" ] || [ -z "${_gad_bin_dir}" ] || [ -z "${_gad_home}" ]; then
        return 0
    fi
    if ! gc_setup_host_is_android; then
        return 0
    fi
    if gc_setup_host_resolv_ok; then
        unset _gad_vendor _gad_bin_dir _gad_home
        return 0
    fi
    _gad_resolv="${_gad_home}/resolv.conf"
    if ! gc_setup_write_resolv_conf "${_gad_resolv}"; then
        out_info "This host has no usable /etc/resolv.conf, so grok may fail DNS (common on Termux). Next: export XAI_API_KEY, or grok login from a host with working DNS."
        unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
        return 0
    fi
    if ! command -v proot >/dev/null 2>&1; then
        gc_setup_ensure_termux_proot
    fi
    if ! command -v proot >/dev/null 2>&1; then
        out_info "Wrote ${_gad_resolv}, but proot is not on PATH so grok cannot bind it over /etc/resolv.conf. grok login may fail DNS. Next: pkg install proot, then ${APP_NAME} setup --force, or export XAI_API_KEY."
        unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
        return 0
    fi
    if ! gc_setup_smoke_version "${_gad_vendor}" proot; then
        out_info "Wrote ${_gad_resolv}, but proot cannot run grok here. grok login may fail DNS. Next: export XAI_API_KEY, or grok login from a host with working DNS."
        unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
        return 0
    fi
    if ! gc_setup_write_exec_wrapper "${_gad_bin_dir}/grok" "${_gad_vendor}" proot "${_gad_resolv}"; then
        out_info "Wrote ${_gad_resolv}, but could not rewrite the grok wrapper. Next: export XAI_API_KEY, or grok login from a host with working DNS."
        unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
        return 0
    fi
    ln -sf grok "${_gad_bin_dir}/agent" 2>/dev/null || true
    out_info "Bound ${_gad_resolv} over /etc/resolv.conf via proot so grok can resolve auth.x.ai (vendor binary unchanged)."
    unset _gad_vendor _gad_bin_dir _gad_home _gad_resolv
    return 0
}

# =============================================================================
# gc_setup_maybe_bashrc() - append vendor-style PATH block when SHELL is bash
# =============================================================================
gc_setup_maybe_bashrc() {
    _gmb_bin_dir="${1:-}"
    _gmb_shell=$(basename "${SHELL:-}")
    [ "${_gmb_shell}" = "bash" ] || return 0
    _gmb_rc="${HOME}/.bashrc"
    if grep -qs "grok installer" "${_gmb_rc}" 2>/dev/null; then
        return 0
    fi
    printf '\n# >>> grok installer >>>\nexport PATH="%s:$PATH"\n# <<< grok installer <<<\n' "${_gmb_bin_dir}" >> "${_gmb_rc}" 2>/dev/null || true
    return 0
}

# =============================================================================
# gc_setup() - Type 0: place peer grok via studied xAI channel + artifact
# =============================================================================
#
# GENERAL PURPOSE:
# Detect platform, fetch the channel version pointer, download
# grok-{version}-{os}-{arch} into GROK_HOME/downloads (not cache/tmp),
# refuse a wrong ELF machine, smoke --version there, and link
# ~/.grok/bin/grok (and agent). On Android, retry ET_EXEC via
# TERMUX_EXEC_OPTOUT, Termux pkg install -y proot when missing, or
# proot, and place a wrapper — do not byte-patch.
# MUST NOT download or exec install.sh. MUST NOT require bash. Skip if
# grok already runs on this host unless --force. An x86_64 file copied
# onto aarch64 Termux is not a skip. grok on disk is success even when
# this session's PATH is stale. A stale Android proot wrapper is
# rewritten on that skip (no network) so grok -p can exit.
#
# ALIGNMENT:
# - requirement-grok-setup.md
# - requirement-shell-cli-interface.md
# - requirement-operator-readable-error.md
#
# Last updated: 2026-09-07
# =============================================================================
gc_setup() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${FORCE:=0}"
    : "${GROK_VENDOR_BASE_URL:=https://x.ai/cli}"
    : "${GROK_VENDOR_FALLBACK_URL:=https://storage.googleapis.com/grok-build-public-artifacts/cli}"
    : "${GROK_CHANNEL:=stable}"
    : "${GROK_PEER_NAME:=grok}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    _peer=$(gc_resolve_grok_peer)
    _host_platform=$(gc_setup_detect_platform) || _host_platform=""
    _host_arch=""
    if [ -n "${_host_platform}" ]; then
        _host_arch="${_host_platform#*-}"
    fi
    if [ -n "${_peer}" ] && [ "${FORCE}" -ne 1 ]; then
        if gc_setup_peer_usable "${_peer}" "${_host_arch}"; then
            gc_setup_heal_android_wrapper "${_peer}"
            out_success "grok is already installed at ${_peer}."
            gc_setup_print_next "${_peer}"
            if [ "${JSON}" -eq 1 ]; then
                _on_path="false"
                gc_peer_on_current_path && _on_path="true"
                out_json "setup" "grok is already installed at ${_peer}." \
                    "app" "${APP_NAME}" \
                    "status" "already_installed" \
                    "peer" "${GROK_PEER_NAME}" \
                    "peer_path" "${_peer}" \
                    "on_path" "${_on_path}" \
                    "vendor_base" "${GROK_VENDOR_BASE_URL}"
            fi
            return 0
        fi
        if [ -n "${GC_SETUP_PEER_UNUSABLE:-}" ]; then
            out_info "Existing grok at ${_peer} cannot run on this host (${GC_SETUP_PEER_UNUSABLE}). Fetching a matching grok."
        fi
    fi

    if ! command -v curl >/dev/null 2>&1; then
        out_die "curl is not on PATH, so ${APP_NAME} cannot download grok. Next: install curl, then ${APP_NAME} setup."
    fi
    if ! command -v uname >/dev/null 2>&1; then
        out_die "uname is not on PATH, so ${APP_NAME} cannot detect the grok platform. Next: install uname, then ${APP_NAME} setup."
    fi

    case "${GROK_CHANNEL}" in
        stable|alpha|enterprise) ;;
        *)
            out_die "Invalid GROK_CHANNEL (${GROK_CHANNEL}). Next: set GROK_CHANNEL to stable, alpha, or enterprise, then ${APP_NAME} setup."
            ;;
    esac

    if [ -n "${_host_platform}" ]; then
        _platform="${_host_platform}"
    else
        _platform=$(gc_setup_detect_platform) || _platform=""
    fi
    if [ -z "${_platform}" ]; then
        out_die "Unsupported OS or architecture ($(uname -s)/$(uname -m)). Next: use linux or macos on x86_64 or aarch64, then ${APP_NAME} setup."
    fi
    _want_arch="${_platform#*-}"

    if [ -n "${GROK_SETUP_VERSION:-}" ]; then
        if ! gc_setup_version_ok "${GROK_SETUP_VERSION}"; then
            out_die "Invalid GROK_SETUP_VERSION (${GROK_SETUP_VERSION}). Next: use X.Y.Z, then ${APP_NAME} setup."
        fi
        _version="${GROK_SETUP_VERSION}"
    else
        out_info "Fetching latest ${GROK_CHANNEL} grok version from ${GROK_VENDOR_BASE_URL}"
        GC_SETUP_POINTER=""
        if gc_setup_read_pointer "${GROK_CHANNEL}"; then
            _version="${GC_SETUP_POINTER}"
        else
            _version=""
        fi
        if [ -z "${_version}" ]; then
            _ptr_det="${GC_SETUP_CURL_DETAIL:-}"
            if [ -n "${_ptr_det}" ]; then
                out_die "Download of the grok version pointer failed (${_ptr_det} from ${GROK_VENDOR_BASE_URL}/${GROK_CHANNEL}). This did not install ${APP_NAME}. Next: check network to x.ai, then ${APP_NAME} setup."
            fi
            out_die "Download of the grok version pointer failed (${GROK_VENDOR_BASE_URL}/${GROK_CHANNEL}). This did not install ${APP_NAME}. Next: check network to x.ai, then ${APP_NAME} setup."
        fi
    fi

    _home_grok=$(gc_resolve_grok_home)
    _download_dir="${_home_grok}/downloads"
    if [ -n "${GROK_BIN_DIR:-}" ]; then
        _bin_dir="${GROK_BIN_DIR}"
    else
        _bin_dir="${_home_grok}/bin"
    fi
    if ! mkdir -p "${_download_dir}"; then
        out_die "Could not create ${_download_dir}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
    fi
    # Studied installer smokes from ~/.grok/downloads (exec-capable). Cache
    # /tmp /dev/shm may be noexec (Termux/Android). Do not use util_mktemp.
    _tmp=$(mktemp "${_download_dir}/grok-${_platform}.XXXXXX" 2>/dev/null || true)
    if [ -z "${_tmp}" ] || [ ! -f "${_tmp}" ]; then
        out_die "Could not create a temp file for the grok binary. Next: check disk under ${_download_dir}, then ${APP_NAME} setup."
    fi
    out_info "Downloading grok ${_version} (${_platform})"
    if ! gc_setup_fetch_artifact "${_version}" "${_platform}" "${_tmp}"; then
        rm -f "${_tmp}"
        _bin_det="${GC_SETUP_CURL_DETAIL:-}"
        if [ -n "${_bin_det}" ]; then
            out_die "Download of the grok binary failed (${_bin_det} for grok-${_version}-${_platform}). This did not install ${APP_NAME}. Next: check network to x.ai, then ${APP_NAME} setup."
        fi
        out_die "Download of the grok binary failed (grok-${_version}-${_platform}). This did not install ${APP_NAME}. Next: check network to x.ai, then ${APP_NAME} setup."
    fi
    if ! chmod 0755 "${_tmp}"; then
        rm -f "${_tmp}"
        out_die "Could not chmod the downloaded grok under ${_download_dir}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
    fi
    _got_elf=$(gc_setup_elf_arch "${_tmp}") || _got_elf=""
    if [ -n "${_got_elf}" ] && [ -n "${_want_arch}" ] && [ "${_got_elf}" != "${_want_arch}" ]; then
        rm -f "${_tmp}"
        out_die "The downloaded grok is the wrong architecture (${_got_elf} ELF, this host needs ${_want_arch} / ${_platform}). This did not install ${APP_NAME}. Next: run ${APP_NAME} setup --force on this device (do not scp grok from an x86_64 host onto aarch64 Termux), then ${APP_NAME} setup."
    fi
    GC_SETUP_SMOKE_METHOD="direct"
    if ! gc_setup_smoke_version "${_tmp}"; then
        _smoke_detail="${GC_SETUP_SMOKE_DETAIL:-}"
        case "${_smoke_detail}" in
            *EM_X86_64*|*EM_AARCH64*|*EM_X86*)
                rm -f "${_tmp}"
                out_die "The downloaded grok is the wrong architecture for this host (${_smoke_detail}). This did not install ${APP_NAME}. Next: run ${APP_NAME} setup --force on this device (do not scp grok from an x86_64 host onto aarch64 Termux), then ${APP_NAME} setup."
                ;;
        esac
        if gc_setup_host_is_android; then
            if gc_setup_smoke_android "${_tmp}"; then
                out_info "This Android host cannot run the vendor grok file directly; ${APP_NAME} will place a wrapper under ${_bin_dir} (vendor binary unchanged)."
            else
                _smoke_msg="The downloaded grok is a static Linux executable that this Android host refused to run"
                if [ -n "${GC_SETUP_SMOKE_DETAIL:-}" ]; then
                    _smoke_msg="${_smoke_msg} (${GC_SETUP_SMOKE_DETAIL})"
                elif [ -n "${_smoke_detail}" ]; then
                    _smoke_msg="${_smoke_msg} (${_smoke_detail})"
                fi
                if gc_setup_keep_failed_download "${_tmp}" "${_download_dir}" "${_platform}"; then
                    _kept="${GC_SETUP_FAILED_PATH}"
                else
                    _kept="${_tmp}"
                fi
                out_die "${_smoke_msg}. Left the file at ${_kept}. This did not install ${APP_NAME}. Next: pkg install proot, then ${APP_NAME} setup --force (or run grok on a Linux host)."
            fi
        else
            _smoke_msg="The downloaded grok failed to run --version"
            if [ -n "${_smoke_detail}" ]; then
                _smoke_msg="${_smoke_msg} (${_smoke_detail})"
            fi
            rm -f "${_tmp}"
            out_die "${_smoke_msg}. This did not install ${APP_NAME}. Next: check the download, then ${APP_NAME} setup."
        fi
    fi
    if [ "${GC_SETUP_SMOKE_METHOD}" = "optout" ] || [ "${GC_SETUP_SMOKE_METHOD}" = "proot" ]; then
        if ! gc_setup_place_android_wrapper "${_tmp}" "${_download_dir}" "${_bin_dir}" "${_platform}" "${GC_SETUP_SMOKE_METHOD}"; then
            rm -f "${_tmp}"
            out_die "Could not place grok under ${_bin_dir}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
        fi
    else
        if ! gc_setup_place_links "${_tmp}" "${_download_dir}" "${_bin_dir}" "${_platform}"; then
            rm -f "${_tmp}"
            out_die "Could not place grok under ${_bin_dir}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
        fi
    fi
    gc_setup_path_symlink "${_bin_dir}"
    gc_setup_maybe_bashrc "${_bin_dir}"
    _placed_vendor="${_download_dir}/grok-${_platform}"
    if [ -f "${_placed_vendor}" ]; then
        gc_setup_maybe_android_dns "${_placed_vendor}" "${_bin_dir}" "${_home_grok}"
    fi
    if ! gc_setup_host_is_android; then
        if ! gc_setup_host_resolv_ok; then
            out_info "This host has no usable /etc/resolv.conf, so grok may fail DNS (common on Termux). Next: export XAI_API_KEY, or grok login from a host with working DNS."
        fi
    fi

    _peer=$(gc_resolve_grok_peer)
    if [ -z "${_peer}" ]; then
        out_die "The download finished but grok was not found under ${_bin_dir} or ${USER_BIN}. Next: check disk under ${_home_grok}, then ${APP_NAME} setup."
    fi
    out_success "grok is installed at ${_peer}."
    gc_setup_print_next "${_peer}"
    if [ "${JSON}" -eq 1 ]; then
        _on_path="false"
        gc_peer_on_current_path && _on_path="true"
        out_json "setup" "grok is installed at ${_peer}." \
            "app" "${APP_NAME}" \
            "status" "installed" \
            "peer" "${GROK_PEER_NAME}" \
            "peer_path" "${_peer}" \
            "on_path" "${_on_path}" \
            "vendor_base" "${GROK_VENDOR_BASE_URL}" \
            "version" "${_version}" \
            "platform" "${_platform}"
    fi
    return 0
}

# =============================================================================
# gc_resolve_cli_root() - durable host store (default /var/grok-cli)
# =============================================================================
gc_resolve_cli_root() {
    : "${GROK_CLI_ROOT:=/var/grok-cli}"
    printf '%s' "${GROK_CLI_ROOT}"
}

# =============================================================================
# gc_list_auth_files() - Class B: newline list of regular auth.* files
# =============================================================================
gc_list_auth_files() {
    _dir="${1:-}"
    if [ -z "${_dir}" ] || [ ! -d "${_dir}" ]; then
        return 1
    fi
    find "${_dir}" -maxdepth 1 -type f -name 'auth.*' 2>/dev/null | LC_ALL=C sort
}

# =============================================================================
# gc_iso_to_epoch() - Class B: parse grok expires_at to unix seconds
# =============================================================================
gc_iso_to_epoch() {
    _iso="${1:-}"
    [ -n "${_iso}" ] || return 1
    _iso=$(printf '%s' "${_iso}" | sed 's/\.[0-9]*Z$/Z/; s/\.[0-9]*+/+/')
    if date -u -d "${_iso}" +%s >/dev/null 2>&1; then
        date -u -d "${_iso}" +%s
        return 0
    fi
    _plain=$(printf '%s' "${_iso}" | tr 'T' ' ' | sed 's/Z$//; s/+00:00$//; s/+0000$//')
    if date -u -d "${_plain}" +%s >/dev/null 2>&1; then
        date -u -d "${_plain}" +%s
        return 0
    fi
    return 1
}

# =============================================================================
# gc_grok_prompt_int() - Class B: positive integer or default
# =============================================================================
#
# GENERAL PURPOSE:
# Coerce GROK_PROMPT_TIMEOUT / GROK_PROMPT_KILL_AFTER to a positive integer.
# Empty, 0, and non-digits fall back to $2 (default 20 / 2).
#
# ALIGNMENT: requirement-grok-auth-backup.md
# Last updated: 2026-09-07
# =============================================================================
gc_grok_prompt_int() {
    _gpi="${1-}"
    _gpid="${2-20}"
    case "${_gpi}" in
        ''|*[!0-9]*)
            printf '%s' "${_gpid}"
            ;;
        0)
            printf '%s' "${_gpid}"
            ;;
        *)
            printf '%s' "${_gpi}"
            ;;
    esac
}

# =============================================================================
# gc_grok_p_once_run() - grok -p under PRoot: guest death is the done signal
# =============================================================================
#
# GENERAL PURPOSE:
# PRoot often cannot determine grok-linux exited and stays in do_wait.
# Two jobs: collector (peer -p hello → files) and reaper (when grok-linux
# is gone or stdout idle, kill only NEW runsvdir, then SIGKILL collector).
# Match args/exe, not truncated comm. Nested PRoot: run the vendor file.
# Sets _ec. Consumes _peer _out _ihome _ghome _login. INC-20260907-003.
#
# ALIGNMENT: requirement-shell-termux-coding.md · requirement-grok-auth-backup.md
#
# Last updated: 2026-09-07
# =============================================================================
gc_grok_p_once_run() {
    _gpt=$(gc_grok_prompt_int "${GROK_PROMPT_TIMEOUT:-20}" 20)
    _idle="${GROK_P_IDLE:-1}"
    _reapw="${GROK_P_REAP_WAIT:-2}"
    _gbin="${_peer}"
    case "${TERMUX_EXEC__PROC_SELF_EXE:-}" in
        *proot*)
            _ghome_p=$(gc_resolve_grok_home)
            _plat_p=$(gc_setup_detect_platform 2>/dev/null || true)
            if [ -n "${_plat_p}" ] && [ -x "${_ghome_p}/downloads/grok-${_plat_p}" ]; then
                _gbin="${_ghome_p}/downloads/grok-${_plat_p}"
            fi
            unset _ghome_p _plat_p
            ;;
    esac
    _pout=$(util_mktemp grokpo)
    _perr=$(util_mktemp grokpe)
    _pbefore=$(util_mktemp grokpb)
    if [ -z "${_pout}" ] || [ -z "${_perr}" ] || [ -z "${_pbefore}" ]; then
        _ec=1
        unset _gpt _idle _reapw _gbin _pout _perr _pbefore
        return 0
    fi
    ps -eo pid= -o args= 2>/dev/null | awk '
        $2 ~ /\/runsvdir$/ || $2 == "runsvdir" { print $1 }
    ' | sort >"${_pbefore}" 2>/dev/null || :
    HOME="${_ihome}" GROK_HOME="${_ghome}" USER="${_login}" LOGNAME="${_login}" \
        "${_gbin}" -p hello </dev/null >"${_pout}" 2>"${_perr}" &
    _pcol=$!
    (
        _seen=0
        _osize=0
        _idle_since=0
        _start=$(date +%s)
        while :; do
            _now=$(date +%s)
            if [ $((_now - _start)) -ge "${_gpt}" ]; then
                break
            fi
            if ! kill -0 "${_pcol}" 2>/dev/null; then
                exit 0
            fi
            _child=$(ps -eo pid= -o ppid= -o args= 2>/dev/null | awk -v pp="${_pcol}" '
                $2 == pp && ($3 ~ /\/grok-linux/ || $3 ~ /grok-linux/) {
                    print $1
                    exit
                }
            ')
            if [ -n "${_child}" ]; then
                _seen=1
            elif [ "${_seen}" -eq 1 ]; then
                break
            fi
            if [ "${_idle}" -gt 0 ]; then
                _sz=$(wc -c <"${_pout}" 2>/dev/null | tr -d ' \t\n')
                _sz=${_sz:-0}
                if [ "${_sz}" -gt 0 ]; then
                    if [ "${_sz}" -ne "${_osize}" ]; then
                        _osize=${_sz}
                        _idle_since=${_now}
                    elif [ "${_idle_since}" -gt 0 ] && [ $((_now - _idle_since)) -ge "${_idle}" ]; then
                        break
                    fi
                fi
            fi
            sleep 1
        done
        sleep 1
        ps -eo pid= -o args= 2>/dev/null | awk '
            $2 ~ /\/runsvdir$/ || $2 == "runsvdir" { print $1 }
        ' | sort | while read -r _rpid; do
            [ -n "${_rpid}" ] || continue
            if ! grep -qx "${_rpid}" "${_pbefore}" 2>/dev/null; then
                kill "${_rpid}" 2>/dev/null || :
            fi
        done
        _deadline=$(( $(date +%s) + _reapw ))
        while [ "$(date +%s)" -lt "${_deadline}" ]; do
            kill -0 "${_pcol}" 2>/dev/null || exit 0
            sleep 1
        done
        kill "${_pcol}" 2>/dev/null || :
        sleep 1
        kill -9 "${_pcol}" 2>/dev/null || :
        exit 0
    ) &
    _preap=$!
    wait "${_pcol}" 2>/dev/null || :
    wait "${_preap}" 2>/dev/null || :
    : >"${_out}"
    if [ -s "${_perr}" ]; then
        cat "${_perr}" >>"${_out}" 2>/dev/null || :
    fi
    if [ -s "${_pout}" ]; then
        cat "${_pout}" >>"${_out}" 2>/dev/null || :
        _ec=0
    else
        _ec=1
    fi
    rm -f "${_pout}" "${_perr}" "${_pbefore}"
    unset _gpt _idle _reapw _gbin _pout _perr _pbefore _pcol _preap
    return 0
}

# =============================================================================
# gc_grok_prompt_run_bounded() - Run grok -p hello with a hard deadline
# =============================================================================
#
# GENERAL PURPOSE:
# Always bound the live probe. GNU timeout without --kill-after waits forever
# if the child ignores SIGTERM (Termux proot wrapper / vendor grok). Prefer
# timeout -k (SIGKILL after grace). Otherwise a POSIX watchdog (background,
# sleep, kill then kill -9). Optional setsid -w detaches the controlling TTY
# so grok cannot steal the numbered menu. Sets _ec. Consumes _peer _out
# _ihome _ghome _login.
#
# ALIGNMENT: requirement-grok-auth-backup.md · requirement-shell-termux-coding.md
# Last updated: 2026-09-07
# =============================================================================
gc_grok_prompt_run_bounded() {
    : "${GROK_PROMPT_TIMEOUT:=20}"
    : "${GROK_PROMPT_KILL_AFTER:=2}"
    _lim=$(gc_grok_prompt_int "${GROK_PROMPT_TIMEOUT}" 20)
    _killafter=$(gc_grok_prompt_int "${GROK_PROMPT_KILL_AFTER}" 2)
    _ec=1

    # PRoot on PATH: guest-death reaper (INC-20260907-003). Else simple -p.
    if command -v proot >/dev/null 2>&1; then
        gc_grok_p_once_run
        unset _lim _killafter
        return 0
    fi

    if command -v timeout >/dev/null 2>&1 \
        && timeout -k "${_killafter}" 1 true >/dev/null 2>&1; then
        if command -v setsid >/dev/null 2>&1 \
            && setsid -w true >/dev/null 2>&1; then
            HOME="${_ihome}" GROK_HOME="${_ghome}" USER="${_login}" LOGNAME="${_login}" \
                timeout -k "${_killafter}" "${_lim}" setsid -w "${_peer}" -p hello \
                </dev/null >"${_out}" 2>&1
            _ec=$?
        else
            HOME="${_ihome}" GROK_HOME="${_ghome}" USER="${_login}" LOGNAME="${_login}" \
                timeout -k "${_killafter}" "${_lim}" "${_peer}" -p hello \
                </dev/null >"${_out}" 2>&1
            _ec=$?
        fi
        unset _lim _killafter
        return 0
    fi

    HOME="${_ihome}" GROK_HOME="${_ghome}" USER="${_login}" LOGNAME="${_login}" \
        "${_peer}" -p hello </dev/null >"${_out}" 2>&1 &
    _gpid=$!
    _n=0
    while [ "${_n}" -lt "${_lim}" ]; do
        if ! kill -0 "${_gpid}" 2>/dev/null; then
            wait "${_gpid}"
            _ec=$?
            unset _gpid _n _lim _killafter
            return 0
        fi
        sleep 1
        _n=$((_n + 1))
    done
    kill "${_gpid}" 2>/dev/null || true
    sleep "${_killafter}"
    kill -9 "${_gpid}" 2>/dev/null || true
    wait "${_gpid}" 2>/dev/null || true
    _ec=124
    unset _gpid _n _lim _killafter
    return 0
}

# =============================================================================
# gc_grok_prompt_hello() - Live session probe: grok -p hello
# =============================================================================
#
# GENERAL PURPOSE:
# Ask the peer grok one non-interactive question. Exit 0 means grok is
# actually signed in. auth.json parse is NOT this gate — a future expires_at
# can still be revoked, and Termux DNS/wrapper failures stay hidden until
# grok runs. Never print grok's answer or token values.
# When this process is root via sudo, grok MUST see the invoking login's
# home (SUDO_USER), not /root — sudo env_reset otherwise makes grok say
# "login required" after the unprivileged probe already succeeded.
# The probe is always time-bounded (GNU timeout -k, else POSIX watchdog)
# so a Termux proot child that ignores SIGTERM cannot freeze the menu.
#
# ALIGNMENT: requirement-grok-auth-backup.md
#
# Lessons Learned (CIAO Reflection):
# 2026-09-06: sudo -n grok-cli backup re-probed as root with HOME=/root, so
# grok read /root/.grok and failed "login required" despite a valid adm01
# session and an installed NOPASSWD grant. Pin HOME + GROK_HOME on the exec.
# 2026-09-07: Termux menu froze after the header: grok -p hello under proot
# ignored SIGTERM, and timeout without --kill-after waited forever. Always
# bound; SIGKILL follow-up; watchdog when GNU timeout -k is missing.
#
# Last updated: 2026-09-07
# =============================================================================
gc_grok_prompt_hello() {
    GC_GROK_PROMPT_STATUS="missing"
    GC_GROK_PROMPT_DETAIL=""
    _peer=$(gc_resolve_grok_peer)
    if [ -z "${_peer}" ] || [ ! -x "${_peer}" ]; then
        GC_GROK_PROMPT_STATUS="missing"
        GC_GROK_PROMPT_DETAIL="no grok peer"
        unset _peer
        return 1
    fi
    _out=$(util_mktemp grokp)
    if [ -z "${_out}" ]; then
        GC_GROK_PROMPT_STATUS="failed"
        GC_GROK_PROMPT_DETAIL="could not capture probe output"
        unset _peer _out
        return 1
    fi
    : "${GROK_PROMPT_TIMEOUT:=20}"
    : "${GROK_PROMPT_KILL_AFTER:=2}"
    : "${HOME:=/tmp}"
    _ihome=$(gc_invoking_home)
    _ghome=$(gc_resolve_grok_home)
    _login=$(gc_invoking_login)
    : "${_ihome:=${HOME}}"
    : "${_ghome:=${_ihome}/.grok}"
    : "${_login:=$(id -un 2>/dev/null || echo unknown)}"
    _ec=1
    gc_grok_prompt_run_bounded
    if [ "${_ec}" -eq 0 ]; then
        GC_GROK_PROMPT_STATUS="ok"
        GC_GROK_PROMPT_DETAIL=""
        rm -f "${_out}"
        unset _peer _out _ec _ihome _ghome _login
        return 0
    fi
    GC_GROK_PROMPT_STATUS="failed"
    _snip=$(tr '\n' ' ' < "${_out}" 2>/dev/null | cut -c1-160)
    case "${_snip}" in
        *dns*|*resolv*)
            GC_GROK_PROMPT_DETAIL="exit ${_ec}: dns error"
            ;;
        *login*|*unauthor*|*logged*)
            GC_GROK_PROMPT_DETAIL="exit ${_ec}: login required"
            ;;
        *)
            if [ "${_ec}" -eq 124 ] || [ "${_ec}" -eq 137 ]; then
                GC_GROK_PROMPT_DETAIL="exit ${_ec}: probe timed out"
            else
                GC_GROK_PROMPT_DETAIL="exit ${_ec}"
            fi
            ;;
    esac
    rm -f "${_out}"
    unset _peer _out _ec _snip _ihome _ghome _login
    return 1
}

# =============================================================================
# gc_auth_session_ok() - File-shape helper (NOT the session gate)
# =============================================================================
#
# GENERAL PURPOSE:
# Optional auth.json shape check. MUST NOT be used as logged-in. The session
# gate is gc_grok_prompt_hello (grok -p hello). Never print token values.
#
# ALIGNMENT: requirement-grok-auth-backup.md
# =============================================================================
gc_auth_session_ok() {
    _auth="${1:-}"
    [ -n "${_auth}" ] || return 1
    [ -f "${_auth}" ] || return 1
    [ -s "${_auth}" ] || return 1

    if command -v python3 >/dev/null 2>&1; then
        python3 - "${_auth}" <<'PY'
import datetime, json, sys
path = sys.argv[1]
try:
    data = json.load(open(path, encoding="utf-8"))
except Exception:
    sys.exit(1)
if not isinstance(data, dict) or not data:
    sys.exit(1)
now = datetime.datetime.now(datetime.timezone.utc)
for v in data.values():
    if not isinstance(v, dict):
        continue
    has_secret = bool(v.get("key") or v.get("refresh_token"))
    if not has_secret:
        continue
    if v.get("refresh_token"):
        sys.exit(0)
    exp = v.get("expires_at")
    if not exp:
        sys.exit(0)
    s = str(exp).replace("Z", "+00:00")
    if "." in s and "+" in s[s.find("T"):]:
        head, rest = s.split(".", 1)
        tz = ""
        if "+" in rest:
            frac, tz = rest.split("+", 1)
            tz = "+" + tz
        elif "-" in rest:
            frac, tz = rest.split("-", 1)
            tz = "-" + tz
        s = head + tz
    try:
        dt = datetime.datetime.fromisoformat(s)
    except Exception:
        continue
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    if dt > now:
        sys.exit(0)
sys.exit(1)
PY
        return $?
    fi

    # Fallback without python3: refresh_token, or expires_at still in the future.
    if grep -q '"refresh_token"[[:space:]]*:[[:space:]]*"[^"]' "${_auth}" 2>/dev/null; then
        return 0
    fi
    _exp=$(sed -n 's/.*"expires_at"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${_auth}" 2>/dev/null | head -n1)
    if [ -n "${_exp}" ]; then
        _exp_s=$(gc_iso_to_epoch "${_exp}") || return 1
        _now=$(date -u +%s)
        if [ "${_exp_s}" -gt "${_now}" ] 2>/dev/null; then
            return 0
        fi
        return 1
    fi
    if grep -q '"key"[[:space:]]*:[[:space:]]*"[^"]' "${_auth}" 2>/dev/null; then
        return 0
    fi
    return 1
}

# =============================================================================
# gc_session_status_word() - Class B: valid|invalid|missing
# =============================================================================
#
# GENERAL PURPOSE:
# valid = grok -p hello succeeded. missing = no peer grok. invalid = probe
# failed. MUST NOT use auth.json parse as logged-in.
#
# ALIGNMENT: requirement-grok-auth-backup.md
# =============================================================================
gc_session_status_word() {
    if gc_grok_prompt_hello; then
        printf '%s' "valid"
        return 0
    fi
    if [ "${GC_GROK_PROMPT_STATUS:-}" = "missing" ]; then
        printf '%s' "missing"
        return 0
    fi
    printf '%s' "invalid"
    return 0
}

# =============================================================================
# gc_session_is_valid() - 0 when grok is logged in
# =============================================================================
#
# GENERAL PURPOSE:
# True when grok -p hello succeeded. Reuses GC_SESSION_STATUS_CACHE from
# the main menu in the same process (avoids a second probe). Direct CLI
# with an empty cache runs the live probe.
#
# ALIGNMENT: requirement-grok-auth-backup.md
# Last updated: 2026-09-07
# =============================================================================
gc_session_is_valid() {
    if [ -n "${GC_SESSION_STATUS_CACHE:-}" ]; then
        [ "${GC_SESSION_STATUS_CACHE}" = "valid" ]
        return $?
    fi
    _gc_ss=$(gc_session_status_word) || true
    [ "${_gc_ss}" = "valid" ]
}

# =============================================================================
# gc_sync_skip_if_logged_in() - 0 when sync must not copy
# =============================================================================
#
# GENERAL PURPOSE:
# If this environment is already logged in, print the skip message and
# return 0 so sync-auth / sync-auth-from-remote do not overwrite auth.*.
#
# ALIGNMENT: requirement-grok-auth-backup.md
# Last updated: 2026-09-07
# =============================================================================
gc_sync_skip_if_logged_in() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    _verb="${1:-sync-auth}"
    if gc_session_is_valid; then
        out_info "No sync-auth for logged-in environment."
        if [ "${JSON}" -eq 1 ]; then
            out_json "${_verb}" "No sync-auth for logged-in environment." \
                "status" "skipped" \
                "app" "${APP_NAME}" \
                "reason" "logged-in" \
                "session" "valid"
        fi
        return 0
    fi
    return 1
}

# =============================================================================
# gc_check_session() - Type 0: grok login gate
# =============================================================================
#
# GENERAL PURPOSE:
# Tell the operator whether grok is actually signed in. Runs grok -p hello
# first. Backup MUST call gc_grok_prompt_hello before any deposit.
#
# ALIGNMENT: requirement-grok-auth-backup.md
# =============================================================================
gc_check_session() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    _home=$(gc_resolve_grok_home)
    _auth="${_home}/auth.json"
    if gc_grok_prompt_hello; then
        out_success "Grok is logged in (grok -p hello succeeded)."
        if [ -f "${_auth}" ]; then
            out_info "Auth file: ${_auth}"
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "check-session" "ok" \
                "app" "${APP_NAME}" \
                "grok_home" "${_home}" \
                "auth_json" "${_auth}" \
                "session" "valid" \
                "probe" "grok -p hello"
        fi
        return 0
    fi
    if [ "${GC_GROK_PROMPT_STATUS:-}" = "missing" ]; then
        out_die "Grok is not installed (no grok on PATH or under ${_home}/bin). Next: ${APP_NAME} setup, then grok login, then ${APP_NAME} check-session."
    fi
    _extra=""
    if [ -n "${GC_GROK_PROMPT_DETAIL:-}" ]; then
        _extra=" (${GC_GROK_PROMPT_DETAIL})"
    fi
    out_die "Grok is not logged in${_extra}. Next: grok login, then ${APP_NAME} check-session."
}

# =============================================================================
# gc_dest_needs_elev() - production /var/grok-cli write needs root
# =============================================================================
gc_dest_needs_elev() {
    _d="${1:-}"
    : "${_d:=/var/grok-cli}"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        return 1
    fi
    case "${_d}" in
        /var/grok-cli|/var/grok-cli/*)
            return 0
            ;;
    esac
    if [ -d "${_d}" ] && [ -w "${_d}" ]; then
        return 1
    fi
    if mkdir -p "${_d}" 2>/dev/null && [ -w "${_d}" ]; then
        return 1
    fi
    return 0
}

# =============================================================================
# gc_deposit_auth() - copy auth.* into dest; root chowns root:root
# =============================================================================
#
# GENERAL PURPOSE:
# Push matching auth.* files into the durable store. When running as root,
# chown root:root and chmod so a normal login can later sync-auth without sudo
# (dir 0755, files 0644).
# =============================================================================
gc_deposit_auth() {
    _src="${1:-}"
    _dest="${2:-}"
    : "${APP_NAME:=grok-cli}"
    if [ -z "${_src}" ] || [ ! -d "${_src}" ]; then
        out_die "Grok home is not a directory: ${_src}"
    fi
    if [ -z "${_dest}" ]; then
        out_die "Deposit directory is empty"
    fi

    _list=$(gc_list_auth_files "${_src}") || _list=""
    if [ -z "${_list}" ]; then
        out_die "No auth.* files under ${_src}. Next step: run grok login so ${APP_NAME} can copy ~/.grok/auth.*."
    fi

    if [ ! -d "${_dest}" ]; then
        mkdir -p "${_dest}" || out_die "Cannot create ${_dest} (need allowlisted sudo ${APP_NAME} backup). Run: ${APP_NAME} print-sudoers and ask sudoer-adm to approve the JSON grant."
    fi
    if [ ! -w "${_dest}" ]; then
        out_die "Cannot write ${_dest}. Only an approved passwordless sudo ${APP_NAME} backup may push files there."
    fi

    _copied=""
    _n=0
    # Portable newline loop
    while IFS= read -r _f; do
        [ -n "${_f}" ] || continue
        [ -f "${_f}" ] || continue
        _bn=$(basename -- "${_f}")
        _outp="${_dest}/${_bn}"
        if command -v install >/dev/null 2>&1; then
            install -m 0644 "${_f}" "${_outp}" || out_die "Failed to copy ${_bn} into ${_dest}"
        else
            cp "${_f}" "${_outp}" || out_die "Failed to copy ${_bn} into ${_dest}"
            chmod 0644 "${_outp}" 2>/dev/null || true
        fi
        if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
            chown root:root "${_outp}" 2>/dev/null || true
            chmod 0644 "${_outp}" 2>/dev/null || true
        fi
        _copied="${_copied}${_bn} "
        _n=$((_n + 1))
    done <<EOF
${_list}
EOF

    if [ "${_n}" -le 0 ]; then
        out_die "No auth.* files were copied from ${_src}"
    fi

    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        chown root:root "${_dest}" 2>/dev/null || true
        chmod 0755 "${_dest}" 2>/dev/null || true
    fi

    GC_LAST_COPIED="${_copied}"
    GC_LAST_COUNT="${_n}"
    return 0
}

# =============================================================================
# gc_backup() - check valid grok session, then push auth.* to /var/grok-cli
# =============================================================================
#
# GENERAL PURPOSE:
# 1) Fail closed unless grok -p hello succeeds (live session).
# 2) As a normal login, re-exec the managed global binary via passwordless
#    sudo (JSON grant approved by sudoer-adm): sudo grok-cli backup.
# 3) As root, copy ~/.grok/auth.* into GROK_CLI_ROOT, chown root:root, chmod
#    world-readable so sync-auth needs no sudo.
#
# ALIGNMENT:
# - requirement-grok-auth-backup.md
# - requirement-sudoer-json-file.md (grant is grok-cli backup only)
# - requirement-three-layer-privilege-model.md
# - requirement-operator-readable-error.md
#
# Lessons Learned (CIAO Reflection):
# 2026-09-06: sudo child "grok is not logged in" is not a missing grant.
# Do not tell the operator to generate-sudoer-request when the fragment
# already allows passwordless backup.
#
# Last updated: 2026-09-06
# =============================================================================
gc_backup() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _src=$(gc_resolve_grok_home)
    _dest=$(gc_resolve_cli_root)
    _auth="${_src}/auth.json"

    if ! gc_grok_prompt_hello; then
        if [ "${GC_GROK_PROMPT_STATUS:-}" = "missing" ]; then
            out_die "Cannot backup: grok is not installed (no grok on PATH or under ${_src}/bin). Next: ${APP_NAME} setup, then grok login, then ${APP_NAME} backup."
        fi
        _extra=""
        if [ -n "${GC_GROK_PROMPT_DETAIL:-}" ]; then
            _extra=" (${GC_GROK_PROMPT_DETAIL})"
        fi
        out_die "Cannot backup: grok is not logged in${_extra}. Next: grok login, then ${APP_NAME} backup."
    fi

    _list=$(gc_list_auth_files "${_src}") || _list=""
    if [ -z "${_list}" ]; then
        out_die "Cannot backup: no auth.* files under ${_src}."
    fi

    if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ] && gc_dest_needs_elev "${_dest}"; then
        _bin="${GLOBAL_BIN}/${APP_NAME}"
        if [ ! -x "${_bin}" ]; then
            out_die "Cannot push to ${_dest}: need the global binary ${_bin} (sudo ${APP_NAME} backup). Next step: sudo sh src/${APP_NAME} install, then ${APP_NAME} generate-sudoer-request and ${APP_NAME} submit-sudoer-request so sudoer-adm can approve passwordless sudo ${APP_NAME} backup."
        fi
        if ! command -v sudo >/dev/null 2>&1; then
            out_die "sudo not found. Pushing into ${_dest} needs passwordless sudo ${APP_NAME} backup after sudoer-adm approval."
        fi
        out_info "Session valid. Elevating: sudo -n ${_bin} backup"
        _sudo_ec=0
        if [ "${JSON}" -eq 1 ]; then
            sudo -n "${_bin}" backup >/dev/null
            _sudo_ec=$?
        else
            sudo -n "${_bin}" backup
            _sudo_ec=$?
        fi
        if [ "${_sudo_ec}" -ne 0 ]; then
            if gc_sudoers_grants_backup; then
                out_die "Elevated ${APP_NAME} backup failed after sudo ran ${_bin} backup. The passwordless grant is already in place. See the error above. Next: grok login, then ${APP_NAME} backup."
            fi
            out_die "sudo ${APP_NAME} backup was refused. Next step: ${APP_NAME} generate-sudoer-request && ${APP_NAME} submit-sudoer-request, then ask sudoer-adm to approve the JSON grant (NOPASSWD ${_bin} backup)."
        fi
        if [ "${JSON}" -ne 1 ]; then
            return 0
        fi
        # JSON parent: report dest after child deposit
        _n=0
        _names=""
        _child_list=$(gc_list_auth_files "${_dest}") || _child_list=""
        while IFS= read -r _f; do
            [ -n "${_f}" ] || continue
            _n=$((_n + 1))
            _names="${_names}$(basename -- "${_f}") "
        done <<EOF
${_child_list}
EOF
        if [ "${_n}" -le 0 ]; then
            out_die "Elevated backup returned success but ${_dest} has no auth.* files."
        fi
        out_json "backup" "ok" \
            "app" "${APP_NAME}" \
            "grok_home" "${_src}" \
            "destination" "${_dest}" \
            "files" "${_names}" \
            "count" "${_n}" \
            "owner" "root:root" \
            "elevated" "true"
        return 0
    fi

    out_info "Session valid. Depositing auth.* from ${_src} → ${_dest}"
    gc_deposit_auth "${_src}" "${_dest}"
    _owner="invoking-user"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        _owner="root:root"
    fi
    out_success "Backup complete: ${_dest} (${GC_LAST_COUNT:-0} file(s): ${GC_LAST_COPIED:-})"
    out_info "Store owner/mode: ${_owner}; files 0644 so a normal login can ${APP_NAME} sync-auth without sudo."
    if [ "${JSON}" -eq 1 ]; then
        out_json "backup" "ok" \
            "app" "${APP_NAME}" \
            "grok_home" "${_src}" \
            "destination" "${_dest}" \
            "files" "${GC_LAST_COPIED:-}" \
            "count" "${GC_LAST_COUNT:-0}" \
            "owner" "${_owner}" \
            "elevated" "$([ "$(id -u 2>/dev/null || echo 1)" -eq 0 ] && echo true || echo false)"
    fi
    return 0
}

# =============================================================================
# gc_sync_auth() - Type 0: copy /var/grok-cli/auth.* into ~/.grok (no sudo)
# =============================================================================
#
# GENERAL PURPOSE:
# A normal login reads the root-owned store and writes owner-only copies into
# that login's grok home. MUST NOT call sudo. MUST NOT copy when grok is
# already logged in (No sync-auth for logged-in environment).
#
# ALIGNMENT: requirement-grok-auth-backup.md
# Last updated: 2026-09-07
# =============================================================================
gc_sync_auth() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    if gc_sync_skip_if_logged_in "sync-auth"; then
        return 0
    fi
    _src=$(gc_resolve_cli_root)
    _dest=$(gc_resolve_grok_home)

    if [ ! -d "${_src}" ]; then
        out_die "Cannot sync-auth: store missing (${_src}). Next step: someone with an approved sudo ${APP_NAME} backup must push auth.* first."
    fi
    _list=$(gc_list_auth_files "${_src}") || _list=""
    if [ -z "${_list}" ]; then
        out_die "Cannot sync-auth: no readable auth.* under ${_src}. Next step: run ${APP_NAME} backup (after grok login) so the store is populated; files must be world-readable (0644)."
    fi

    if [ ! -d "${_dest}" ]; then
        mkdir -p "${_dest}" || out_die "Cannot create ${_dest}"
    fi
    chmod 0700 "${_dest}" 2>/dev/null || true

    _copied=""
    _n=0
    while IFS= read -r _f; do
        [ -n "${_f}" ] || continue
        [ -r "${_f}" ] || out_die "Cannot read ${_f} without sudo. The store file must be world-readable (backup chmod 0644)."
        _bn=$(basename -- "${_f}")
        _outp="${_dest}/${_bn}"
        if command -v install >/dev/null 2>&1; then
            install -m 0600 "${_f}" "${_outp}" || out_die "Failed to write ${_outp}"
        else
            cp "${_f}" "${_outp}" || out_die "Failed to write ${_outp}"
            chmod 0600 "${_outp}" 2>/dev/null || true
        fi
        case "${_bn}" in
            auth.json)
                chmod 0600 "${_outp}" 2>/dev/null || true
                ;;
        esac
        _copied="${_copied}${_bn} "
        _n=$((_n + 1))
    done <<EOF
${_list}
EOF

    if [ "${_n}" -le 0 ]; then
        out_die "sync-auth copied nothing from ${_src}"
    fi
    out_success "sync-auth complete: ${_src} → ${_dest} (${_n} file(s): ${_copied})"
    if [ "${JSON}" -eq 1 ]; then
        out_json "sync-auth" "ok" \
            "app" "${APP_NAME}" \
            "source" "${_src}" \
            "grok_home" "${_dest}" \
            "files" "${_copied}" \
            "count" "${_n}"
    fi
    return 0
}

# =============================================================================
# gc_scp_cmd() - Class B: scp binary (GROK_CLI_SCP or PATH)
# =============================================================================
#
# GENERAL PURPOSE:
# Return the scp program sync-auth-from-remote will invoke. Tests inject a
# fake via GROK_CLI_SCP so the suite never opens a real SSH session.
#
# ALIGNMENT:
# - requirement-grok-auth-backup.md
#
# Last updated: 2026-09-02
# =============================================================================
gc_scp_cmd() {
    : "${GROK_CLI_SCP:=}"
    if [ -n "${GROK_CLI_SCP}" ]; then
        printf '%s' "${GROK_CLI_SCP}"
        return 0
    fi
    command -v scp 2>/dev/null || true
}

# =============================================================================
# gc_host_is_ipv4() - Class B: dotted-quad 0-255
# =============================================================================
#
# Last updated: 2026-09-02
# =============================================================================
gc_host_is_ipv4() {
    _h="${1-}"
    [ -n "${_h}" ] || return 1
    _n=0
    _rest="${_h}."
    while [ -n "${_rest}" ]; do
        _oct="${_rest%%.*}"
        _rest="${_rest#*.}"
        case "${_oct}" in
            ''|*[!0-9]*) return 1 ;;
        esac
        if [ "${_oct}" -lt 0 ] || [ "${_oct}" -gt 255 ]; then
            return 1
        fi
        _n=$((_n + 1))
        if [ "${_n}" -gt 4 ]; then
            return 1
        fi
    done
    [ "${_n}" -eq 4 ]
}

# =============================================================================
# gc_host_is_dns() - Class B: hostname / domain-name labels
# =============================================================================
#
# Last updated: 2026-09-02
# =============================================================================
gc_host_is_dns() {
    _h="${1-}"
    [ -n "${_h}" ] || return 1
    case "${_h}" in
        *[!A-Za-z0-9.-]*|.*|*..*|*.) return 1 ;;
        -*|*-) return 1 ;;
    esac
    case "${_h}" in
        *[A-Za-z]*) return 0 ;;
        *) return 1 ;;
    esac
}

# =============================================================================
# gc_parse_remote_spec() - parse user@host | host | domain into GC_REMOTE_*
# =============================================================================
#
# GENERAL PURPOSE:
# Accept SPEC forms: user@IPv4, IPv4, domain-name, user@domain-name.
# Reject empty, extra @, paths, and shell metacharacters. Sets GC_REMOTE_USER
# (may be empty) and GC_REMOTE_HOST.
#
# ALIGNMENT:
# - requirement-grok-auth-backup.md
#
# Last updated: 2026-09-02
# =============================================================================
gc_parse_remote_spec() {
    _spec="${1-}"
    GC_REMOTE_USER=""
    GC_REMOTE_HOST=""
    if [ -z "${_spec}" ]; then
        return 1
    fi
    case "${_spec}" in
        *[';|&$`()<>\\/ '*]*|*'*'*|*\[*|*\]*)
            return 1
            ;;
        -*)
            return 1
            ;;
    esac
    _atcount=0
    _tmp="${_spec}"
    while [ -n "${_tmp}" ]; do
        case "${_tmp}" in
            *@*)
                _atcount=$((_atcount + 1))
                _tmp="${_tmp#*@}"
                ;;
            *)
                _tmp=""
                ;;
        esac
    done
    if [ "${_atcount}" -gt 1 ]; then
        return 1
    fi
    if [ "${_atcount}" -eq 1 ]; then
        GC_REMOTE_USER="${_spec%@*}"
        GC_REMOTE_HOST="${_spec#*@}"
        if [ -z "${GC_REMOTE_USER}" ] || [ -z "${GC_REMOTE_HOST}" ]; then
            GC_REMOTE_USER=""
            GC_REMOTE_HOST=""
            return 1
        fi
        case "${GC_REMOTE_USER}" in
            *[!A-Za-z0-9_.-]*)
                GC_REMOTE_USER=""
                GC_REMOTE_HOST=""
                return 1
                ;;
        esac
        case "${GC_REMOTE_USER}" in
            [A-Za-z_]*|[0-9]*)
                ;;
            *)
                GC_REMOTE_USER=""
                GC_REMOTE_HOST=""
                return 1
                ;;
        esac
    else
        GC_REMOTE_HOST="${_spec}"
    fi
    if gc_host_is_ipv4 "${GC_REMOTE_HOST}"; then
        return 0
    fi
    if gc_host_is_dns "${GC_REMOTE_HOST}"; then
        return 0
    fi
    GC_REMOTE_USER=""
    GC_REMOTE_HOST=""
    return 1
}

# =============================================================================
# gc_preferred_remote_path() - Class B: persistence leaf for preferred SPEC
# =============================================================================
#
# ALIGNMENT: requirement-grok-auth-backup.md · requirement-shell-cli-storage.md
# Last updated: 2026-09-07
# =============================================================================
gc_preferred_remote_path() {
    : "${APP_NAME:=grok-cli}"
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        export PERSISTENT_STORAGE_DIR
    fi
    printf '%s' "${PERSISTENT_STORAGE_DIR}/preferred-remote"
}

# =============================================================================
# gc_preferred_remote_load() - Class B: stored SPEC or empty
# =============================================================================
#
# GENERAL PURPOSE:
# Read persistence preferred-remote. Print a valid SPEC or empty.
# Invalid stored lines are ignored (not used as a default).
#
# ALIGNMENT: requirement-grok-auth-backup.md
# Last updated: 2026-09-07
# =============================================================================
gc_preferred_remote_load() {
    _pr_path=$(gc_preferred_remote_path)
    if [ ! -f "${_pr_path}" ]; then
        printf '%s' ""
        return 0
    fi
    _pr_line=$(head -n1 "${_pr_path}" 2>/dev/null || true)
    _pr_line=$(printf '%s' "${_pr_line}" | tr -d '\r')
    if [ -z "${_pr_line}" ]; then
        printf '%s' ""
        return 0
    fi
    if gc_parse_remote_spec "${_pr_line}"; then
        printf '%s' "${_pr_line}"
        return 0
    fi
    printf '%s' ""
    return 0
}

# =============================================================================
# gc_preferred_remote_save() - write a valid SPEC to persistence
# =============================================================================
#
# ALIGNMENT: requirement-grok-auth-backup.md · requirement-shell-cli-storage.md
# Last updated: 2026-09-07
# =============================================================================
gc_preferred_remote_save() {
    _pr_spec="${1-}"
    if ! gc_parse_remote_spec "${_pr_spec}"; then
        return 1
    fi
    _pr_path=$(gc_preferred_remote_path)
    printf '%s\n' "${_pr_spec}" > "${_pr_path}" || return 1
    chmod 0600 "${_pr_path}" 2>/dev/null || true
    return 0
}

# =============================================================================
# gc_sync_auth_from_remote() - Type 0: scp remote store auth.* into ~/.grok
# =============================================================================
#
# GENERAL PURPOSE:
# Pull auth.* from a remote host's GROK_CLI_REMOTE_ROOT (default /var/grok-cli)
# into this login's grok home. SPEC is user@host, host IPv4, domain-name, or
# user@domain-name. Uses scp in BatchMode (no password hang). MUST NOT sudo.
# Dest auth.json mode 0600. Tests inject GROK_CLI_SCP. Preferred SPEC is
# loaded/saved under persistence preferred-remote.
#
# ALIGNMENT:
# - requirement-grok-auth-backup.md
# - requirement-shell-cli-storage.md
# - requirement-operator-readable-error.md
#
# Last updated: 2026-09-07
# =============================================================================
gc_sync_auth_from_remote() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${TTY:=0}"
    : "${GROK_CLI_REMOTE_ROOT:=/var/grok-cli}"
    : "${HOME:=/tmp}"

    if gc_sync_skip_if_logged_in "sync-auth-from-remote"; then
        return 0
    fi

    _spec="${1-}"
    if [ -z "${_spec}" ] && [ "${TTY}" -eq 1 ] && [ "${JSON}" -ne 1 ]; then
        _pref=$(gc_preferred_remote_load)
        prompt_ask "Remote (user@host, IPv4, domain, or user@domain)" "${_pref}"
        _spec="${PROMPT_ASK_VALUE}"
    fi
    if [ -z "${_spec}" ]; then
        out_die "Cannot sync-auth-from-remote: missing remote. Next: ${APP_NAME} sync-auth-from-remote USER@HOST"
    fi
    if ! gc_parse_remote_spec "${_spec}"; then
        out_die "Cannot sync-auth-from-remote: remote '${_spec}' is not user@host, IPv4, domain, or user@domain. Next: ${APP_NAME} sync-auth-from-remote USER@HOST"
    fi

    _scp=$(gc_scp_cmd)
    if [ -z "${_scp}" ] || [ ! -x "${_scp}" ]; then
        out_die "Cannot sync-auth-from-remote: scp not found. Next: install openssh-client, then ${APP_NAME} sync-auth-from-remote ${_spec}"
    fi

    _dest=$(gc_resolve_grok_home)
    if [ ! -d "${_dest}" ]; then
        mkdir -p "${_dest}" || out_die "Cannot create ${_dest}"
    fi
    chmod 0700 "${_dest}" 2>/dev/null || true

    _auth_src="${GROK_CLI_REMOTE_ROOT}/auth.json"
    if [ -n "${GC_REMOTE_USER}" ]; then
        _remote="${GC_REMOTE_USER}@${GC_REMOTE_HOST}:${_auth_src}"
        _label="${GC_REMOTE_USER}@${GC_REMOTE_HOST}"
    else
        _remote="${GC_REMOTE_HOST}:${_auth_src}"
        _label="${GC_REMOTE_HOST}"
    fi

    _tmp=$(util_mktemp authjson)
    out_info "Fetching auth.json from ${_label}"
    if ! "${_scp}" -o BatchMode=yes -o ConnectTimeout=15 "${_remote}" "${_tmp}"; then
        rm -f "${_tmp}"
        out_die "Cannot sync-auth-from-remote: scp from ${_label} failed. Next: ssh ${_label}, then ${APP_NAME} sync-auth-from-remote ${_spec}"
    fi
    if [ ! -s "${_tmp}" ]; then
        rm -f "${_tmp}"
        out_die "Cannot sync-auth-from-remote: remote ${_label} has no auth.json under ${GROK_CLI_REMOTE_ROOT}. Next: on that host run ${APP_NAME} backup, then ${APP_NAME} sync-auth-from-remote ${_spec}"
    fi

    _outp="${_dest}/auth.json"
    if command -v install >/dev/null 2>&1; then
        install -m 0600 "${_tmp}" "${_outp}" || out_die "Failed to write ${_outp}"
    else
        cp "${_tmp}" "${_outp}" || out_die "Failed to write ${_outp}"
        chmod 0600 "${_outp}" 2>/dev/null || true
    fi
    rm -f "${_tmp}"
    chmod 0600 "${_outp}" 2>/dev/null || true

    _copied="auth.json "
    _n=1
    _lock_src="${GROK_CLI_REMOTE_ROOT}/auth.json.lock"
    if [ -n "${GC_REMOTE_USER}" ]; then
        _lock_remote="${GC_REMOTE_USER}@${GC_REMOTE_HOST}:${_lock_src}"
    else
        _lock_remote="${GC_REMOTE_HOST}:${_lock_src}"
    fi
    _ltmp=$(util_mktemp authlock)
    if "${_scp}" -o BatchMode=yes -o ConnectTimeout=15 "${_lock_remote}" "${_ltmp}" 2>/dev/null; then
        if [ -s "${_ltmp}" ]; then
            if command -v install >/dev/null 2>&1; then
                install -m 0600 "${_ltmp}" "${_dest}/auth.json.lock" || true
            else
                cp "${_ltmp}" "${_dest}/auth.json.lock" 2>/dev/null || true
                chmod 0600 "${_dest}/auth.json.lock" 2>/dev/null || true
            fi
            if [ -f "${_dest}/auth.json.lock" ]; then
                _copied="${_copied}auth.json.lock "
                _n=$((_n + 1))
            fi
        fi
    fi
    rm -f "${_ltmp}"

    out_success "sync-auth-from-remote complete: ${_label}:${GROK_CLI_REMOTE_ROOT} → ${_dest} (${_n} file(s): ${_copied})"
    if [ "${JSON}" -eq 1 ]; then
        out_json "sync-auth-from-remote" "ok" \
            "app" "${APP_NAME}" \
            "remote" "${_label}" \
            "host" "${GC_REMOTE_HOST}" \
            "user" "${GC_REMOTE_USER}" \
            "source" "${GROK_CLI_REMOTE_ROOT}" \
            "grok_home" "${_dest}" \
            "files" "${_copied}" \
            "count" "${_n}"
    fi
    gc_preferred_remote_save "${_spec}" || true
    return 0
}

# =============================================================================
# gc_crontab_cmd() - Class B: crontab binary (GROK_CLI_CRONTAB or PATH)
# =============================================================================
#
# GENERAL PURPOSE:
# Return the crontab program add-crontab will invoke. Tests inject a fake
# via GROK_CLI_CRONTAB so the suite never writes the operator's real crontab.
#
# ALIGNMENT:
# - requirement-grok-crontab.md
#
# Last updated: 2026-09-02
# =============================================================================
gc_crontab_cmd() {
    : "${GROK_CLI_CRONTAB:=}"
    if [ -n "${GROK_CLI_CRONTAB}" ]; then
        printf '%s' "${GROK_CLI_CRONTAB}"
        return 0
    fi
    command -v crontab 2>/dev/null || true
}

# =============================================================================
# gc_cron_backup_job() / gc_cron_sync_job() - Class B: studied crontab lines
# =============================================================================
#
# GENERAL PURPOSE:
# Emit one crontab line (no trailing newline) matching the host pattern:
#   */30 * * * * sudo /usr/local/bin/grok-cli backup
#   45 * * * * /usr/local/bin/grok-cli sync-auth
# Login is not on the line: user crontab is already per-login.
#
# ALIGNMENT:
# - requirement-grok-crontab.md
#
# Last updated: 2026-09-02
# =============================================================================
gc_cron_backup_job() {
    : "${APP_NAME:=grok-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${GROK_CLI_CRON_BACKUP:=*/30 * * * *}"
    printf '%s sudo %s/%s backup' "${GROK_CLI_CRON_BACKUP}" "${GLOBAL_BIN}" "${APP_NAME}"
}

gc_cron_sync_job() {
    : "${APP_NAME:=grok-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${GROK_CLI_CRON_SYNC:=45 * * * *}"
    printf '%s %s/%s sync-auth' "${GROK_CLI_CRON_SYNC}" "${GLOBAL_BIN}" "${APP_NAME}"
}

# =============================================================================
# gc_crontab_text_has() - Class B: needle present in crontab text
# =============================================================================
#
# Last updated: 2026-09-02
# =============================================================================
gc_crontab_text_has() {
    _hay="${1-}"
    _ndl="${2-}"
    [ -n "${_ndl}" ] || return 1
    case "${_hay}" in
        *"${_ndl}"*) return 0 ;;
        *) return 1 ;;
    esac
}

# =============================================================================
# gc_sudoers_grants_backup() - this login's fragment grants NOPASSWD backup
# =============================================================================
#
# GENERAL PURPOSE:
# Return 0 only when THIS login (id -un) has an installed sudoers fragment
# that allows passwordless {{GLOBAL_BIN}}/grok-cli backup. Other users'
# grok-cli-<other> files do not count. Wrong username / missing NOPASSWD /
# extra argv / different verb fail closed.
#
# ALIGNMENT:
# - requirement-grok-crontab.md
# - requirement-sudoer-json-file.md
# - requirement-three-layer-privilege-model.md
#
# Last updated: 2026-09-02
# =============================================================================
gc_sudoers_grants_backup() {
    : "${APP_NAME:=grok-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _user=$(gc_current_login_user)
    _bin="${GLOBAL_BIN}/${APP_NAME}"
    _need="${_user} ALL=(root) NOPASSWD: ${_bin} backup"
    _path=""
    if _path=$(gc_probe_current_user_host_sudoers); then
        :
    else
        return 1
    fi
    if [ -r "${_path}" ]; then
        while IFS= read -r _line || [ -n "${_line}" ]; do
            case "${_line}" in
                "${_need}"|"${_need} ")
                    return 0
                    ;;
            esac
        done < "${_path}"
        return 1
    fi
    # Fragment exists (probe) but is unreadable: corroborate sudo -n -l only.
    if command -v sudo >/dev/null 2>&1; then
        _lst=$(sudo -n -l 2>/dev/null || true)
        if gc_crontab_text_has "${_lst}" "${_bin} backup"; then
            return 0
        fi
    fi
    return 1
}

# =============================================================================
# gc_add_crontab() - Type 0: install backup + sync-auth jobs in this crontab
# =============================================================================
#
# GENERAL PURPOSE:
# Ensure this login's user crontab contains the studied grok-cli timer jobs.
# Fail closed unless this login's installed sudoers fragment grants
# passwordless grok-cli backup. Never writes /etc or another user's crontab.
# Idempotent: missing lines are appended; existing command lines are kept.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: grant + global binary + crontab cmd checked before write
# - Intentional: two studied lines; sync-auth stays unprivileged
# - Anti-fragile: re-run does not duplicate; other jobs preserved
# - Over-protect: wrong-user / wrong-argv fragments are refusals
#
# ALIGNMENT:
# - requirement-grok-crontab.md
# - requirement-operator-readable-error.md
# - requirement-shell-idempotency.md
#
# Last updated: 2026-09-02
# =============================================================================
gc_add_crontab() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"

    _user=$(gc_current_login_user)
    _bin="${GLOBAL_BIN}/${APP_NAME}"
    _cron=$(gc_crontab_cmd)
    _backup_job=$(gc_cron_backup_job)
    _sync_job=$(gc_cron_sync_job)
    _backup_cmd="sudo ${_bin} backup"
    _sync_cmd="${_bin} sync-auth"

    if [ ! -x "${_bin}" ]; then
        out_die "Cannot add crontab: need the global binary ${_bin} (sudoers grants that path). Next: sudo sh src/${APP_NAME} install, then ${APP_NAME} add-crontab."
    fi
    if ! gc_sudoers_grants_backup; then
        out_die "Cannot add crontab: no passwordless sudo ${_bin} backup grant for this login (${_user}). Next: ${APP_NAME} generate-sudoer-request && ${APP_NAME} submit-sudoer-request, then ask sudoer-adm to approve."
    fi
    if [ -z "${_cron}" ] || [ ! -x "${_cron}" ]; then
        out_die "Cannot add crontab: crontab command not found. Next: install cron, then ${APP_NAME} add-crontab."
    fi

    _listed=""
    if _listed=$("${_cron}" -l 2>/dev/null); then
        :
    else
        _listed=""
    fi
    case "${_listed}" in
        "no crontab for"*) _listed="" ;;
    esac

    _have_backup=0
    _have_sync=0
    if gc_crontab_text_has "${_listed}" "${_backup_cmd}"; then
        _have_backup=1
    fi
    if gc_crontab_text_has "${_listed}" "${_sync_cmd}"; then
        _have_sync=1
    fi

    if [ "${_have_backup}" -eq 1 ] && [ "${_have_sync}" -eq 1 ]; then
        out_success "add-crontab: backup and sync-auth jobs already present for ${_user}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "add-crontab" "ok" \
                "app" "${APP_NAME}" \
                "user" "${_user}" \
                "backup_job" "${_backup_job}" \
                "sync_job" "${_sync_job}" \
                "added_backup" "false" \
                "added_sync" "false" \
                "already_present" "true"
        fi
        return 0
    fi

    _tmp=$(util_mktemp crontab)
    if [ -n "${_listed}" ]; then
        printf '%s\n' "${_listed}" > "${_tmp}"
    else
        : > "${_tmp}"
    fi
    _added_backup="false"
    _added_sync="false"
    if [ "${_have_backup}" -eq 0 ]; then
        printf '%s\n' "${_backup_job}" >> "${_tmp}"
        _added_backup="true"
    fi
    if [ "${_have_sync}" -eq 0 ]; then
        printf '%s\n' "${_sync_job}" >> "${_tmp}"
        _added_sync="true"
    fi
    if ! "${_cron}" "${_tmp}"; then
        rm -f "${_tmp}"
        out_die "Cannot add crontab: crontab install failed. Next: check crontab -l, then ${APP_NAME} add-crontab."
    fi
    rm -f "${_tmp}"

    out_success "add-crontab complete for ${_user}: backup every 30 minutes; sync-auth at minute 45"
    out_info "Jobs use ${_bin} (sudoers grants that path). sync-auth does not use sudo."
    if [ "${JSON}" -eq 1 ]; then
        out_json "add-crontab" "ok" \
            "app" "${APP_NAME}" \
            "user" "${_user}" \
            "backup_job" "${_backup_job}" \
            "sync_job" "${_sync_job}" \
            "added_backup" "${_added_backup}" \
            "added_sync" "${_added_sync}" \
            "already_present" "false"
    fi
    return 0
}

# =============================================================================
#
# Prints one of: production | test_local | unmanaged
# production = executable global managed binary present
# test_local = only local user-bin managed binary
# unmanaged  = neither path executable
#
# ALIGNMENT: requirement-three-layer-privilege-model.md §2.3.1a
# =============================================================================
gc_sudoers_trust_tier() {
    : "${APP_NAME:=grok-cli}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    # Shell ship unit needs read+execute for the classifying process. Mode 0711
    # is -x but not -r for non-owners → not a usable multi-user production install.
    if [ -r "${GLOBAL_BIN}/${APP_NAME}" ] && [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        printf '%s' "production"
        return 0
    fi
    if [ -r "${USER_BIN}/${APP_NAME}" ] && [ -x "${USER_BIN}/${APP_NAME}" ]; then
        printf '%s' "test_local"
        return 0
    fi
    printf '%s' "unmanaged"
    return 0
}

# =============================================================================
# gc_sudoers_fragment_text() - Class B: emit draft sudoers text to stdout
# =============================================================================
#
# GENERAL PURPOSE:
# Build the sudoer-file text dual of gc_sudoers_json_text (same verbs, no *).
#
# ALIGNMENT:
# - requirement-sudoer-json-file.md
# - requirement-three-layer-privilege-model.md
# - requirement-domain-grok-cli.md
#
# Last reviewed: 2026-08-15
# =============================================================================
gc_sudoers_fragment_text() {
    : "${APP_NAME:=grok-cli}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _tier=$(gc_sudoers_trust_tier)
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _local_path="${USER_BIN}/${APP_NAME}"
    _installed=$(gc_default_installed_sudoers_path)
    _purpose="Allow ${_user} to run ${APP_NAME} backup as root."

    if [ "${_tier}" = "production" ]; then
        _trust_banner="# Trust tier: production (global managed binary: ${_global_path})
# Residual: elevating backup as root can read the invoking user's ~/.grok/auth.* and write /var/grok-cli.
# Multi-user: install as ${_installed} (per-user suffix; do not overwrite other users)."
    else
        _trust_banner="# =============================================================================
# WARNING: TEST MODE ONLY — NOT PRODUCTION-SECURE
# Local/unmanaged install: user can rewrite ${_local_path}.
# Uninstall this fragment soon:
#   sudo rm ${_installed}
# Production path: sudo ${APP_NAME} install  → re-emit print-sudoers → re-review → reinstall
# Multi-user: installed name is per-user (${APP_NAME}-<user>) so users do not overwrite each other.
# ============================================================================="
    fi

    cat <<EOF
# Purpose: ${_purpose}
# ${APP_NAME} — ${APP_NAME} backup only (review before install)
# Target user: ${_user}
# Install: sudo install -m 0440 <this-file> ${_installed}
# Validate: sudo visudo -c -f ${_installed}
# Trust tier: ${_tier}
${_trust_banner}
#
# Grant is the project command only. Does NOT elevate ${_local_path}.
# Does NOT allowlist mkdir/cp/tar/rm/install/chmod (complexity weakens security).
# After elev, the ship unit copies auth.* and chown/chmod internally.
${_user} ALL=(root) NOPASSWD: ${_global_path} backup
EOF
}

# =============================================================================
# gc_sudoers_json_text() - Class B: emit JSON sudoer file to stdout
# =============================================================================
#
# GENERAL PURPOSE:
# JSON sudoer file (requirement-sudoer-json-file). action from SUBMIT_ACTION.
#
# ALIGNMENT: requirement-sudoer-json-file.md
# Last reviewed: 2026-08-15
# =============================================================================
gc_sudoers_json_text() {
    : "${APP_NAME:=grok-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${SUBMIT_ACTION:=add}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _action="${SUBMIT_ACTION}"
    case "${_action}" in
        add|update) ;;
        *) _action="add" ;;
    esac

    cat <<EOF
{
  "schema_version": 1,
  "purpose": "Allow ${_user} to run ${APP_NAME} backup as root.",
  "username": "${_user}",
  "service": "${APP_NAME}",
  "action": "${_action}",
  "commands": [
    {
      "runas": "root",
      "tags": ["NOPASSWD"],
      "path": "${_global_path}",
      "args": ["backup"]
    }
  ]
}
EOF
}

# Compact one-line dual of gc_sudoers_json_text (same grant). Legal JSON.
# Sibling sudoer-cli 1.6.1 splits commands[] only on the token },{ — pretty
# emit survives 1.6.2+; compact is the submit/generate handoff so inbound
# still names backup (INC-20260817-001 / 002).
gc_sudoers_json_text_compact() {
    : "${APP_NAME:=grok-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${SUBMIT_ACTION:=add}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _action="${SUBMIT_ACTION}"
    case "${_action}" in
        add|update) ;;
        *) _action="add" ;;
    esac

    printf '%s\n' "{\"schema_version\":1,\"purpose\":\"Allow ${_user} to run ${APP_NAME} backup as root.\",\"username\":\"${_user}\",\"service\":\"${APP_NAME}\",\"action\":\"${_action}\",\"commands\":[{\"runas\":\"root\",\"tags\":[\"NOPASSWD\"],\"path\":\"${_global_path}\",\"args\":[\"backup\"]}]}"
}

# =============================================================================
# gc_sudoers_refuse_forbidden_grant() - Fail closed on OS-tool sudoer files
# =============================================================================
#
# ALIGNMENT: requirement-sudoer-json-file.md §2.7 AC-7
# =============================================================================
gc_sudoers_refuse_forbidden_grant() {
    _gf="${1:-}"
    : "${APP_NAME:=grok-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    if [ -z "${_gf}" ] || [ ! -f "${_gf}" ]; then
        out_die "sudoer grant file missing"
    fi
    _gb=$(cat "${_gf}" 2>/dev/null || true)
    case "${_gb}" in
        *"/usr/bin/mkdir"*|*"/bin/mkdir"*|*"/usr/bin/cp"*|*"/bin/cp"*|*"/usr/bin/tar"*|*"/bin/tar"*|*"/bin/rm "*|*"/usr/bin/rm "*|*"/usr/bin/install"*|*"/usr/bin/chmod"*|*"/bin/chmod"*)
            out_die "refusing sudoer grant with OS-tool commands (need ${GLOBAL_BIN}/${APP_NAME} backup only)"
            ;;
    esac
    return 0
}

# Fail closed unless the file still names the backup verb.
gc_sudoers_verify_grant_verbs() {
    _gf="${1:-}"
    : "${APP_NAME:=grok-cli}"
    if [ -z "${_gf}" ] || [ ! -f "${_gf}" ]; then
        out_die "sudoer file missing (cannot verify backup)"
    fi
    _gb=$(cat "${_gf}" 2>/dev/null || true)
    case "${_gb}" in
        *'"backup"'*) ;;
        *) out_die "Sudoer file is incomplete: it does not allow backup. Path: ${_gf}" ;;
    esac
    return 0
}

# When sudoer-cli is present, convert must still list backup.
# Returns 0 if convert kept both; 1 if sudoer-cli is absent (caller may skip).
gc_sudoers_verify_sibling_convert() {
    _gf="${1:-}"
    : "${APP_NAME:=grok-cli}"
    _cli=""
    if _cli=$(gc_detect_sudoer_cli); then
        :
    else
        return 1
    fi
    # Stub CLIs used in suite only implement add/update. Skip convert unless
    # help lists json-to-sudoers (real sudoer-cli).
    _help=$("${_cli}" help 2>/dev/null || true)
    case "${_help}" in
        *json-to-sudoers*) ;;
        *) return 1 ;;
    esac
    _outf=$(util_mktemp sudoer-conv)
    if ! "${_cli}" json-to-sudoers --file "${_gf}" --out "${_outf}" >/dev/null 2>&1; then
        rm -f "${_outf}"
        out_die "sudoer-cli json-to-sudoers failed for ${_gf}. The file is not safe to submit."
    fi
    _txt=$(cat "${_outf}" 2>/dev/null || true)
    rm -f "${_outf}"
    case "${_txt}" in
        *" ${APP_NAME} backup"*|*"/${APP_NAME} backup"*) ;;
        *) out_die "sudoer-cli convert dropped backup from ${_gf}. Do not submit this file. Install sudoer-cli 1.6.2+ or regenerate with ${APP_NAME} generate-sudoer-request." ;;
    esac
    return 0
}

# =============================================================================
# gc_print_sudoers() - Emit narrow sudoers fragment (does NOT write /etc)
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-grok-cli.md
# - requirement-three-layer-privilege-model.md
# - requirement-grok-auth-backup.md (session check + auth deposit)
#
# Last reviewed: 2026-08-14
# =============================================================================
gc_print_sudoers() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${GROK_CLI_ROOT:=/var/grok-cli}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _dest="${GROK_CLI_ROOT}"
    _out_path="${1:-}"
    _tier=$(gc_sudoers_trust_tier)
    _test_mode="false"
    _global_path="${GLOBAL_BIN}/${APP_NAME}"

    if [ "${_tier}" != "production" ]; then
        _test_mode="true"
        if [ "${ALLOW_TEST_LOCAL_SUDOERS}" -ne 1 ]; then
            out_die "print-sudoers trust tier is ${_tier} (not production). Local/user-rewritable install is TEST MODE ONLY. Prefer: sudo ${APP_NAME} install  (global ${_global_path}). To emit a test fragment anyway: ${APP_NAME} print-sudoers --allow-test-local [path]  or ALLOW_TEST_LOCAL_SUDOERS=1"
        fi
    fi

    _installed=$(gc_default_installed_sudoers_path)
    _draft_default=$(gc_default_project_sudoers_path)
    _fragment=$(gc_sudoers_fragment_text)

    if [ "${_test_mode}" = "true" ] && [ "${JSON}" -eq 0 ]; then
        out_warn "TEST MODE ONLY: trust tier=${_tier}. Uninstall ${_installed} soon. Prefer global install for production."
    fi

    if [ -n "${_out_path}" ]; then
        _dir=$(dirname -- "${_out_path}")
        if [ ! -d "${_dir}" ]; then
            mkdir -p "${_dir}" || out_die "Cannot create ${_dir}"
        fi
        printf '%s\n' "${_fragment}" > "${_out_path}" || out_die "Cannot write ${_out_path}"
        _json_path="${_out_path}.json"
        gc_sudoers_json_text > "${_json_path}" || out_die "Cannot write ${_json_path}"
        out_success "Wrote sudoers fragment to ${_out_path}"
        out_info "JSON sudoer file: ${_json_path}"
        out_info "Admin: sudo visudo -c -f ${_out_path}"
        out_info "Admin: sudo install -m 0440 ${_out_path} ${_installed}"
        if [ "${_test_mode}" = "true" ]; then
            out_warn "Admin (test mode): plan uninstall soon → sudo rm ${_installed}"
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "print-sudoers" "written" \
                "path" "${_out_path}" \
                "user" "${_user}" \
                "installed_path" "${_installed}" \
                "dest" "${_dest}" \
                "trust_tier" "${_tier}" \
                "test_mode" "${_test_mode}"
        fi
        return 0
    fi

    if [ "${JSON}" -eq 1 ]; then
        # Avoid huge JSON with full fragment; give path guidance
        out_json "print-sudoers" "use human mode or path arg to capture fragment" \
            "user" "${_user}" \
            "dest" "${_dest}" \
            "installed_path" "${_installed}" \
            "trust_tier" "${_tier}" \
            "test_mode" "${_test_mode}" \
            "hint" "${APP_NAME} print-sudoers --allow-test-local ${_draft_default}"
        return 0
    fi

    out_info "Sudoers fragment for user ${_user} → ${GLOBAL_BIN}/${APP_NAME} backup (trust_tier=${_tier})"
    out_warn "Host Type 1 is sudo ${APP_NAME} backup (NOPASSWD) after sudoer-adm approves the JSON grant."
    out_info "Admin steps: review → visudo -c -f FILE → install -m 0440 FILE ${_installed}"
    out_empty_line
    out_plain "${_fragment}"
    out_empty_line
    out_info "Tip: ${APP_NAME} print-sudoers ${_draft_default}"
    out_info "Admin script: ${APP_NAME} print-sudoers-install-script"
}

# =============================================================================
# gc_detect_sudoer_cli() - Class B: path of sudoer-cli, or fail
# =============================================================================
#
# GENERAL PURPOSE:
# Locate the sudoer-cli binary (env override, global bin, user bin, PATH).
# Does not claim the approval queues exist.
#
# ALIGNMENT:
# - requirement-domain-grok-cli.md
# - requirement-three-layer-privilege-model.md
#
# Last reviewed: 2026-08-14
# =============================================================================
gc_detect_sudoer_cli() {
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SUDOER_CLI:=}"

    if [ -n "${SUDOER_CLI}" ]; then
        if [ -x "${SUDOER_CLI}" ]; then
            printf '%s' "${SUDOER_CLI}"
            return 0
        fi
        return 1
    fi
    if [ -x "${GLOBAL_BIN}/sudoer-cli" ]; then
        printf '%s' "${GLOBAL_BIN}/sudoer-cli"
        return 0
    fi
    if [ -x "${USER_BIN}/sudoer-cli" ]; then
        printf '%s' "${USER_BIN}/sudoer-cli"
        return 0
    fi
    _found=$(command -v sudoer-cli 2>/dev/null || true)
    if [ -n "${_found}" ] && [ -x "${_found}" ]; then
        printf '%s' "${_found}"
        return 0
    fi
    return 1
}

# =============================================================================
# gc_detect_sudoer_adm() - Class B: sudoer-adm login if present
# =============================================================================
#
# GENERAL PURPOSE:
# Probe whether the least-privilege approver account exists (id).
# Account name defaults to sudoer-adm; override with SUDOER_ADM_USER.
#
# ALIGNMENT:
# - requirement-domain-grok-cli.md
# - requirement-three-layer-privilege-model.md
#
# Last reviewed: 2026-08-14
# =============================================================================
gc_detect_sudoer_adm() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    if id "${SUDOER_ADM_USER}" >/dev/null 2>&1; then
        printf '%s' "${SUDOER_ADM_USER}"
        return 0
    fi
    return 1
}

# =============================================================================
# gc_detect_sudoer_inbound() - Class B: inbound approval dir if present
# =============================================================================
#
# GENERAL PURPOSE:
# Find the sibling public inbound (preferred /var/sudoer-cli/sudoer-request).
# Type 0 MUST NOT mkdir. Order: env override → public → F4 view → legacy.
#
# ALIGNMENT:
# - requirement-three-layer-privilege-model.md §2.3.3c (AC-16)
# - requirement-domain-grok-cli.md
#
# Last reviewed: 2026-08-15
# =============================================================================
gc_detect_sudoer_inbound() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUDOER_QUEUE_INBOUND:=}"
    : "${SUDOER_APPROVAL_APP:=sudoer-cli}"
    : "${SUDOER_INBOUND_BASENAME:=sudoer-request}"
    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP}}"

    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ -d "${SUDOER_QUEUE_INBOUND}" ]; then
        printf '%s' "${SUDOER_QUEUE_INBOUND}"
        return 0
    fi

    _home=""
    if command -v getent >/dev/null 2>&1; then
        _home=$(getent passwd "${SUDOER_ADM_USER}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_home}" ] && [ -r /etc/passwd ]; then
        _home=$(awk -F: -v u="${SUDOER_ADM_USER}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
    fi

    for _cand in \
        "${SUDOER_PUBLIC_ROOT}/${SUDOER_INBOUND_BASENAME}" \
        ${_home:+"${_home}/${SUDOER_INBOUND_BASENAME}"} \
        ${_home:+"${_home}/sudoer-approving"} \
        "/etc/${SUDOER_ADM_USER}/sudoer-approving" \
        "/home/${SUDOER_ADM_USER}/sudoer-approving"
    do
        if [ -n "${_cand}" ] && [ -d "${_cand}" ]; then
            printf '%s' "${_cand}"
            return 0
        fi
    done
    return 1
}

# =============================================================================
# gc_sudoer_queue_root_from_inbound() - parent of real public inbound, or test override
# =============================================================================
# MUST NOT treat a legacy …/sudoer-approving parent as the public queue root.
# =============================================================================
gc_sudoer_queue_root_from_inbound() {
    _in="${1:-}"
    [ -n "${_in}" ] || return 1
    _base=$(basename -- "${_in}")
    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ "${_in}" = "${SUDOER_QUEUE_INBOUND}" ]; then
        dirname -- "${_in}"
        return 0
    fi
    if [ "${_base}" = "${SUDOER_INBOUND_BASENAME:-sudoer-request}" ]; then
        _real="${_in}"
        if command -v readlink >/dev/null 2>&1; then
            _resolved=$(readlink -f "${_in}" 2>/dev/null || true)
            [ -n "${_resolved}" ] && _real="${_resolved}"
        fi
        dirname -- "${_real}"
        return 0
    fi
    return 1
}

# =============================================================================
# gc_sudoers_require_emit_trust() - Fail-closed unless production or test-allow
# =============================================================================
gc_sudoers_require_emit_trust() {
    : "${APP_NAME:=grok-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"
    _cmd="${1:-submit-sudoer-request}"
    _tier=$(gc_sudoers_trust_tier)
    if [ "${_tier}" != "production" ]; then
        if [ "${ALLOW_TEST_LOCAL_SUDOERS}" -ne 1 ]; then
            out_die "${_cmd} trust tier is ${_tier} (not production). Prefer: sudo ${APP_NAME} install  (global ${GLOBAL_BIN}/${APP_NAME}). To emit a test file: ${APP_NAME} ${_cmd} --allow-test-local  or ALLOW_TEST_LOCAL_SUDOERS=1"
        fi
    fi
}

# =============================================================================
# gc_generate_sudoer_request() - Type 0: write a local JSON grant you can verify
# =============================================================================
#
# GENERAL PURPOSE:
# Write this product's sudoer JSON to a local path (default under ~/.config),
# verify backup is present, and when sudoer-cli exists convert the
# file so a dropped verb fails here — not after inbound queue. Does not write
# /etc, does not write inbound, does not mkdir inbound.
#
# ALIGNMENT:
# - requirement-three-layer-privilege-model.md §2.3.3d
# - requirement-sudoer-json-file.md
# - requirement-domain-grok-cli.md
# - INC-20260817-002 (operator-readable; incomplete JSON is not a standing class)
#
# Last reviewed: 2026-08-17
# =============================================================================
gc_generate_sudoer_request() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${HOME:=/tmp}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"

    _out_path="${1:-}"
    _user=$(id -un 2>/dev/null || echo "unknown")

    _host_path=""
    _host_present="false"
    if _host_path=$(gc_probe_current_user_host_sudoers); then
        _host_present="true"
    else
        _host_path=""
    fi
    if [ "${SUBMIT_ACTION_EXPLICIT}" -ne 1 ]; then
        if [ "${_host_present}" = "true" ]; then
            SUBMIT_ACTION="update"
        else
            SUBMIT_ACTION="add"
        fi
    fi
    case "${SUBMIT_ACTION}" in
        add|update) ;;
        *) out_die "generate-sudoer-request action must be add or update (got ${SUBMIT_ACTION})" ;;
    esac

    gc_sudoers_require_emit_trust "generate-sudoer-request"

    if [ -z "${_out_path}" ]; then
        _out_path=$(gc_default_sudoer_request_path)
    fi
    case "${_out_path}" in
        /etc|/etc/*)
            out_die "generate-sudoer-request refuses to write under /etc (Type 0). Use a path under \$HOME or /dev/shm."
            ;;
        /var/sudoer-cli|/var/sudoer-cli/*)
            out_die "generate-sudoer-request does not write inbound. Write a local file, then: ${APP_NAME} submit-sudoer-request <path>"
            ;;
    esac
    if [ -e "${_out_path}" ] && [ -L "${_out_path}" ]; then
        out_die "refusing symlink dest: ${_out_path}"
    fi
    if [ -d "${_out_path}" ]; then
        out_die "generate dest is a directory: ${_out_path}"
    fi
    _dir=$(dirname -- "${_out_path}")
    if [ ! -d "${_dir}" ]; then
        mkdir -p "${_dir}" || out_die "Cannot create ${_dir}"
    fi

    gc_sudoers_json_text_compact >"${_out_path}" || out_die "Cannot write ${_out_path}"
    chmod 0644 "${_out_path}" 2>/dev/null || true
    if [ ! -r "${_out_path}" ]; then
        out_die "generated sudoer file is not readable: ${_out_path}"
    fi
    gc_sudoers_refuse_forbidden_grant "${_out_path}"
    gc_sudoers_verify_grant_verbs "${_out_path}"

    _convert="skipped"
    if gc_sudoers_verify_sibling_convert "${_out_path}"; then
        _convert="ok"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "generate-sudoer-request" "written" \
            "path" "${_out_path}" \
            "readable" "true" \
            "verified" "true" \
            "convert_checked" "$([ "${_convert}" = "ok" ] && echo true || echo false)" \
            "action" "${SUBMIT_ACTION}" \
            "host_fragment_present" "${_host_present}" \
            "user" "${_user}"
        return 0
    fi

    out_success "Wrote verified sudoer file to ${_out_path}"
    out_info "Grant allows: ${APP_NAME} backup (action=${SUBMIT_ACTION})"
    if [ "${_convert}" = "ok" ]; then
        out_info "Convert check: backup still present after sudoer-cli json-to-sudoers"
    else
        out_info "Convert check: skipped (sudoer-cli not found). File still lists backup."
    fi
    out_info "Review the file, then submit it:"
    out_info "   ${APP_NAME} submit-sudoer-request ${_out_path}"
}

# =============================================================================
# gc_submit_sudoer_request() - Type 0: queue this product's sudoers for approval
# =============================================================================
#
# GENERAL PURPOSE:
# Detect sudoer-cli and sudoer-adm, emit (or accept) a self-scoped sudoers
# fragment, and submit it via sudoer-cli so a JSON request lands in the
# public inbound (/var/sudoer-cli/sudoer-request). Does not write /etc
# and does not mkdir inbound. Approver (sudoer-adm) still must approve.
# Default emit is the compact verified grant (same as generate-sudoer-request).
#
# ALIGNMENT:
# - requirement-domain-grok-cli.md
# - requirement-three-layer-privilege-model.md
# - requirement-sudoer-json-file.md (JSON grant body: PRJ_NAME only)
# - requirement-shell-cli-interface.md
#
# Last reviewed: 2026-08-17
# =============================================================================
gc_submit_sudoer_request() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${HOME:=/tmp}"
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"
    : "${EFFECTIVE_STORAGE_DIR:=}"

    _src_file="${1:-}"
    _user=$(id -un 2>/dev/null || echo "unknown")
    _purpose="${SUBMIT_PURPOSE}"
    if [ -z "${_purpose}" ]; then
        _purpose="Allow ${_user} to run ${APP_NAME} backup as root."
    fi

    _host_path=""
    _host_present="false"
    if _host_path=$(gc_probe_current_user_host_sudoers); then
        _host_present="true"
    else
        _host_path=""
    fi
    _action_source="explicit"
    if [ "${SUBMIT_ACTION_EXPLICIT}" -ne 1 ]; then
        _action_source="detected"
        if [ "${_host_present}" = "true" ]; then
            SUBMIT_ACTION="update"
        else
            SUBMIT_ACTION="add"
        fi
    fi
    case "${SUBMIT_ACTION}" in
        add|update) ;;
        *) out_die "submit-sudoer-request action must be add or update (got ${SUBMIT_ACTION})" ;;
    esac

    if [ -n "${_src_file}" ]; then
        if [ ! -f "${_src_file}" ]; then
            out_die "sudoers file not found: ${_src_file}"
        fi
        if [ -L "${_src_file}" ]; then
            out_die "refusing symlink sudoers input: ${_src_file}"
        fi
        gc_sudoers_refuse_forbidden_grant "${_src_file}"
    fi

    _cli=""
    if _cli=$(gc_detect_sudoer_cli); then
        :
    else
        out_die "sudoer-cli not found (set SUDOER_CLI or install sudoer-cli to ${GLOBAL_BIN:-/usr/local/bin}/sudoer-cli). Submit is Type 0 compose — this CLI does not write /etc."
    fi

    _adm=""
    if _adm=$(gc_detect_sudoer_adm); then
        :
    else
        out_die "sudoer-adm not found (id ${SUDOER_ADM_USER} failed). Ask an admin to run: sudo sudoer-cli setup"
    fi

    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP:-sudoer-cli}}"
    _inbound=""
    if _inbound=$(gc_detect_sudoer_inbound); then
        :
    else
        out_die "sudoer inbound queue not found (preferred ${SUDOER_PUBLIC_ROOT}/sudoer-request). Ask an admin to run: sudo sudoer-cli setup"
    fi
    if [ ! -w "${_inbound}" ]; then
        out_die "sudoer inbound not writable: ${_inbound}. Check mode 3773 on public inbound (owner ${_adm})."
    fi

    _tmp=""
    if [ -n "${_src_file}" ]; then
        if [ ! -f "${_src_file}" ]; then
            out_die "sudoers file not found: ${_src_file}"
        fi
        if [ -L "${_src_file}" ]; then
            out_die "refusing symlink sudoers input: ${_src_file}"
        fi
        _tmp="${_src_file}"
        _cleanup_tmp=0
    else
        gc_sudoers_require_emit_trust "submit-sudoer-request"
        if [ -z "${EFFECTIVE_STORAGE_DIR}" ]; then
            EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
        fi
        _tmp=$(util_mktemp sudoer)
        gc_sudoers_json_text_compact >"${_tmp}" || out_die "cannot write temp sudoer JSON ${_tmp}"
        _cleanup_tmp=1
    fi
    gc_sudoers_refuse_forbidden_grant "${_tmp}"
    gc_sudoers_verify_grant_verbs "${_tmp}"
    gc_sudoers_verify_sibling_convert "${_tmp}" || true

    # Point sudoer-cli at the public queue root (parent of real inbound).
    # Do not export a legacy sudoer-approving parent as the public trio root.
    if _qr=$(gc_sudoer_queue_root_from_inbound "${_inbound}"); then
        SUDOER_CLI_QUEUE_ROOT="${_qr}"
        export SUDOER_CLI_QUEUE_ROOT
        if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ "${_inbound}" = "${SUDOER_QUEUE_INBOUND}" ]; then
            LPU_HOME="${_qr}"
            export LPU_HOME
        fi
    fi

    _verb="add-sudoer-request"
    if [ "${SUBMIT_ACTION}" = "update" ]; then
        _verb="update-sudoer-request"
    fi

    _errf=$(util_mktemp sudoer-err)
    _out=""
    _rc=0
    if [ "${JSON}" -eq 1 ]; then
        _out=$("${_cli}" --json "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    else
        _out=$("${_cli}" "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    fi
    _err=$(cat "${_errf}" 2>/dev/null || true)
    rm -f "${_errf}"
    if [ "${_cleanup_tmp}" -eq 1 ]; then
        rm -f "${_tmp}"
    fi

    if [ "${_rc}" -ne 0 ]; then
        if [ -n "${_err}" ]; then
            out_die "sudoer-cli ${_verb} failed: ${_err}"
        fi
        out_die "sudoer-cli ${_verb} failed (exit ${_rc})"
    fi

    _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')
    if [ -z "${_rid}" ]; then
        _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*request_id=\([^[:space:]]*\).*/\1/p')
    fi

    # When inbound is readable, queued body MUST still name backup.
    # Purpose text and [OK] submitted are not completeness. INC-20260817-001.
    if [ -n "${_rid}" ] && [ -r "${_inbound}/${_rid}" ]; then
        _ibody=$(cat "${_inbound}/${_rid}" 2>/dev/null || true)
        case "${_ibody}" in
            *'"backup"'*) ;;
            *) out_die "Queued sudo request is incomplete: it does not allow backup. Do not approve ${_rid}. Reject or leave it pending. Write a verified file, then submit that file: ${APP_NAME} generate-sudoer-request && ${APP_NAME} submit-sudoer-request <path>" ;;
        esac
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "submit-sudoer-request" "submitted" \
            "request_id" "${_rid}" \
            "action" "${SUBMIT_ACTION}" \
            "action_source" "${_action_source}" \
            "host_fragment_present" "${_host_present}" \
            "host_fragment_path" "${_host_path}" \
            "service" "${APP_NAME}" \
            "user" "${_user}" \
            "sudoer_cli" "${_cli}" \
            "sudoer_adm" "${_adm}" \
            "inbound" "${_inbound}"
        return 0
    fi

    out_success "Submitted ${SUBMIT_ACTION} request via ${_cli}"
    if [ -n "${_rid}" ]; then
        out_info "request_id=${_rid}"
    fi
    if [ "${_host_present}" = "true" ]; then
        out_info "host_fragment=${_host_path}  (action=${SUBMIT_ACTION} ${_action_source})"
    else
        out_info "host_fragment=absent  (action=${SUBMIT_ACTION} ${_action_source})"
    fi
    out_info "inbound=${_inbound}  (approver: ${_adm})"
    out_info "This CLI did not write /etc. Approver must approve the request."
    return 0
}

# =============================================================================
# gc_current_login_user() - Class B: invoking login name for path suffixes
# =============================================================================
gc_current_login_user() {
    id -un 2>/dev/null || echo "unknown"
}

# =============================================================================
# gc_default_project_sudoers_path() - Class B: default project-sudoers-file path
# =============================================================================
# Per-user draft: ${HOME}/.config/${APP_NAME}/sudoers.fragment-<user>
# Multi-user: each login keeps a distinct draft filename (not a shared basename).
# =============================================================================
gc_default_project_sudoers_path() {
    : "${APP_NAME:=grok-cli}"
    : "${HOME:=/tmp}"
    _user=$(gc_current_login_user)
    printf '%s' "${HOME}/.config/${APP_NAME}/sudoers.fragment-${_user}"
}

# Local verified JSON grant for generate-sudoer-request (not inbound).
gc_default_sudoer_request_path() {
    : "${APP_NAME:=grok-cli}"
    : "${HOME:=/tmp}"
    _user=$(gc_current_login_user)
    printf '%s' "${HOME}/.config/${APP_NAME}/sudoer-request-${_user}.json"
}

# =============================================================================
# gc_default_installed_sudoers_path() - Class B: host /etc/sudoers.d path
# =============================================================================
# Per-user installed name: /etc/sudoers.d/${APP_NAME}-<user>
# Prevents multi-user admin installs from overwriting another user's fragment.
# =============================================================================
gc_sudoers_d_dir() {
    : "${SUDOERS_D_DIR:=/etc/sudoers.d}"
    printf '%s' "${SUDOERS_D_DIR}"
}

gc_default_installed_sudoers_path() {
    : "${APP_NAME:=grok-cli}"
    _user=$(gc_current_login_user)
    printf '%s' "$(gc_sudoers_d_dir)/${APP_NAME}-${_user}"
}

# =============================================================================
# gc_legacy_installed_sudoers_path() - Class B: pre-user-suffix host path
# =============================================================================
gc_legacy_installed_sudoers_path() {
    : "${APP_NAME:=grok-cli}"
    printf '%s' "$(gc_sudoers_d_dir)/${APP_NAME}"
}

# =============================================================================
# gc_list_project_sudoers_drafts() - Class B: list draft paths under config
# =============================================================================
# Emits one absolute path per line: legacy sudoers.fragment then sudoers.fragment-*.
# ALIGNMENT: term project-sudoers-file · multi-user remove-project-sudoers
# =============================================================================
gc_list_project_sudoers_drafts() {
    : "${APP_NAME:=grok-cli}"
    : "${HOME:=/tmp}"
    _dir="${HOME}/.config/${APP_NAME}"
    if [ ! -d "${_dir}" ]; then
        return 0
    fi
    # Legacy un-suffixed draft (pre multi-user naming)
    if [ -f "${_dir}/sudoers.fragment" ]; then
        printf '%s\n' "${_dir}/sudoers.fragment"
    fi
    for _f in "${_dir}"/sudoers.fragment-*; do
        if [ -f "${_f}" ]; then
            case "${_f}" in
                *.json) continue ;;
            esac
            printf '%s\n' "${_f}"
        fi
    done
    return 0
}

# =============================================================================
# gc_list_host_sudoers_fragments() - Class B: list readable host elev paths
# =============================================================================
# Lists /etc/sudoers.d/${APP_NAME} (legacy) and /etc/sudoers.d/${APP_NAME}-*
# when present (probe-only; Type 0 never deletes them).
# =============================================================================
gc_list_host_sudoers_fragments() {
    : "${APP_NAME:=grok-cli}"
    _dir=$(gc_sudoers_d_dir)
    _legacy=$(gc_legacy_installed_sudoers_path)
    if [ -e "${_legacy}" ]; then
        printf '%s\n' "${_legacy}"
    fi
    for _f in "${_dir}"/"${APP_NAME}"-*; do
        if [ -e "${_f}" ]; then
            printf '%s\n' "${_f}"
        fi
    done
    return 0
}

# =============================================================================
# gc_probe_current_user_host_sudoers() - Class B: this user's installed fragment
# =============================================================================
# Prefer per-user ${SUDOERS_D_DIR}/${APP_NAME}-<user>, then legacy unsuffixed.
# Other users' ${APP_NAME}-<other> files do not count.
# Type 0: test -e first (works when the dir is searchable). If the dir is
# 0750/unreadable, try sudo -n test -e (no password; miss → stay-honest absent).
# Prints the first existing path; exit 1 if none found.
# =============================================================================
gc_host_sudoers_exists() {
    _hp="${1:-}"
    [ -n "${_hp}" ] || return 1
    if [ -e "${_hp}" ]; then
        return 0
    fi
    if command -v sudo >/dev/null 2>&1; then
        sudo -n test -e "${_hp}" >/dev/null 2>&1 && return 0
    fi
    return 1
}

gc_probe_current_user_host_sudoers() {
    _per=$(gc_default_installed_sudoers_path)
    _leg=$(gc_legacy_installed_sudoers_path)
    if gc_host_sudoers_exists "${_per}"; then
        printf '%s' "${_per}"
        return 0
    fi
    if [ "${_leg}" != "${_per}" ] && gc_host_sudoers_exists "${_leg}"; then
        printf '%s' "${_leg}"
        return 0
    fi
    return 1
}

# =============================================================================
# gc_default_sudoers_admin_script_path() - Class B: admin install script path
# =============================================================================
#
# Prefer /dev/shm (volatile, multi-user handoff); else EFFECTIVE_STORAGE_DIR /tmp.
# ALIGNMENT: term project-sudoers-file · requirement-three-layer-privilege-model
# =============================================================================
gc_default_sudoers_admin_script_path() {
    : "${APP_NAME:=grok-cli}"
    _user=$(gc_current_login_user)
    _name="${APP_NAME}-${_user}-sudoers-admin.sh"
    if [ -d "/dev/shm" ] && [ -w "/dev/shm" ]; then
        printf '%s' "/dev/shm/${_name}"
        return 0
    fi
    if [ -n "${EFFECTIVE_STORAGE_DIR:-}" ] && [ -d "${EFFECTIVE_STORAGE_DIR}" ] && [ -w "${EFFECTIVE_STORAGE_DIR}" ]; then
        printf '%s' "${EFFECTIVE_STORAGE_DIR}/${_name}"
        return 0
    fi
    printf '%s' "/tmp/${_name}"
    return 0
}

# =============================================================================
# gc_print_sudoers_install_script() - Type 0: emit admin install/uninstall script
# =============================================================================
#
# GENERAL PURPOSE:
# 1) Refresh project-sudoers-file (draft) via gc_print_sudoers
# 2) Write a shell script under /dev/shm (or temp) for an account WITH sudo
#    to install | uninstall | replace the fragment under /etc/sudoers.d/
# Does NOT write /etc itself.
#
# ALIGNMENT:
# - term project-sudoers-file
# - requirement-three-layer-privilege-model.md
#
# Last reviewed: 2026-08-09
# =============================================================================
gc_print_sudoers_install_script() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${HOME:=/tmp}"
    : "${GROK_CLI_ROOT:=/var/grok-cli}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"

    _user=$(gc_current_login_user)
    _draft=$(gc_default_project_sudoers_path)
    _script_out="${1:-}"
    if [ -z "${_script_out}" ]; then
        _script_out=$(gc_default_sudoers_admin_script_path)
    fi
    _installed=$(gc_default_installed_sudoers_path)
    _legacy=$(gc_legacy_installed_sudoers_path)
    _deposit="${GROK_CLI_ROOT}"
    _tier=$(gc_sudoers_trust_tier)

    # Refresh project-sudoers-file first (same trust gate as print-sudoers)
    gc_print_sudoers "${_draft}" || return $?

    _script_dir=$(dirname -- "${_script_out}")
    if [ ! -d "${_script_dir}" ]; then
        mkdir -p "${_script_dir}" || out_die "Cannot create ${_script_dir}"
    fi

    # Refuse writing admin script under /etc
    case "${_script_out}" in
        /etc/*|/etc)
            out_die "Refusing to write admin script under /etc (Type 0). Use /dev/shm or temp path."
            ;;
    esac

    cat > "${_script_out}" <<EOF
#!/bin/sh
# =============================================================================
# ${APP_NAME} — admin sudoers install / uninstall script
# Generated by: ${APP_NAME} print-sudoers-install-script
# Target user (fragment User lines): ${_user}
# Trust tier at generation: ${_tier}
# Project sudoers file (draft): ${_draft}
# Installed path (per-user): ${_installed}
# Legacy shared path (pre multi-user naming): ${_legacy}
#
# RUN AS ROOT (or via sudo), after switching to an account with sudo rights:
#   sudo sh ${_script_out} install     # visudo-check draft → install 0440
#   sudo sh ${_script_out} uninstall   # remove THIS user's installed fragment
#   sudo sh ${_script_out} replace     # uninstall then install (refresh host fragment)
#
# Multi-user: installed path includes the user suffix so install for user A
# does not overwrite /etc/sudoers.d/${APP_NAME}-B for user B.
# This script NEVER embeds passwords. Review draft before install.
# Type 0 CLI must not run this with residual agent power as a silent /etc write.
# =============================================================================
set -u

APP_NAME="${APP_NAME}"
PROJECT_SUDOERS_FILE="${_draft}"
INSTALLED_SUDOERS="${_installed}"
LEGACY_INSTALLED_SUDOERS="${_legacy}"
DEPOSIT_DIR="${_deposit}"
GEN_USER="${_user}"
GEN_TIER="${_tier}"

die() { printf '%s\\n' "ERROR: \$*" >&2; exit 1; }
info() { printf '%s\\n' "\$*"; }

require_root() {
    if [ "\$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
        die "Must run as root (e.g. sudo sh \$0 install). Current uid=\$(id -u)."
    fi
}

cmd_install() {
    require_root
    [ -f "\${PROJECT_SUDOERS_FILE}" ] || die "Missing project sudoers file: \${PROJECT_SUDOERS_FILE} — regenerate with: ${APP_NAME} print-sudoers \${PROJECT_SUDOERS_FILE}"
    if command -v visudo >/dev/null 2>&1; then
        visudo -c -f "\${PROJECT_SUDOERS_FILE}" || die "visudo -c failed on draft"
    else
        info "WARN: visudo not found; skipping syntax check (install carefully)"
    fi
    install -m 0440 -o root -g root "\${PROJECT_SUDOERS_FILE}" "\${INSTALLED_SUDOERS}" \\
        || die "install to \${INSTALLED_SUDOERS} failed"
    if command -v visudo >/dev/null 2>&1; then
        visudo -c -f "\${INSTALLED_SUDOERS}" || die "visudo -c failed on installed file — removing"
    fi
    mkdir -p "\${DEPOSIT_DIR}" 2>/dev/null || true
    chmod 0755 "\${DEPOSIT_DIR}" 2>/dev/null || true
    info "OK: installed \${INSTALLED_SUDOERS} (mode 0440) from \${PROJECT_SUDOERS_FILE}"
    info "Fragment target user at generation: \${GEN_USER} (trust_tier=\${GEN_TIER})"
    info "Multi-user note: other users install to /etc/sudoers.d/\${APP_NAME}-<their-user> (no overwrite)"
    if [ -e "\${LEGACY_INSTALLED_SUDOERS}" ] && [ "\${LEGACY_INSTALLED_SUDOERS}" != "\${INSTALLED_SUDOERS}" ]; then
        info "WARN: legacy shared fragment still present: \${LEGACY_INSTALLED_SUDOERS}"
        info "      Consider admin review/remove if migrating to per-user names."
    fi
    if [ "\${GEN_TIER}" != "production" ]; then
        info "WARN: TEST MODE trust tier — plan uninstall soon: sudo sh \$0 uninstall"
    fi
}

cmd_uninstall() {
    require_root
    if [ ! -e "\${INSTALLED_SUDOERS}" ]; then
        info "OK: \${INSTALLED_SUDOERS} already absent (nothing to uninstall)"
    else
        rm -f "\${INSTALLED_SUDOERS}" || die "Failed to remove \${INSTALLED_SUDOERS}"
        info "OK: removed \${INSTALLED_SUDOERS}"
    fi
    if [ -e "\${LEGACY_INSTALLED_SUDOERS}" ] && [ "\${LEGACY_INSTALLED_SUDOERS}" != "\${INSTALLED_SUDOERS}" ]; then
        info "NOTE: legacy shared fragment still present: \${LEGACY_INSTALLED_SUDOERS}"
        info "      This script only removes the per-user path for \${GEN_USER}."
        info "      To remove legacy: sudo rm \${LEGACY_INSTALLED_SUDOERS}"
    fi
    if command -v visudo >/dev/null 2>&1; then
        visudo -c >/dev/null 2>&1 || info "WARN: visudo -c reported issues after remove (check other fragments)"
    fi
    info "Note: does not remove ${APP_NAME} binaries, other users' fragments, or /var/grok-cli auth files"
}

cmd_replace() {
    cmd_uninstall
    cmd_install
}

cmd_status() {
    if [ -f "\${INSTALLED_SUDOERS}" ]; then
        info "installed: \${INSTALLED_SUDOERS}"
        ls -la "\${INSTALLED_SUDOERS}" 2>/dev/null || true
    else
        info "installed: (absent) \${INSTALLED_SUDOERS}"
    fi
    if [ -e "\${LEGACY_INSTALLED_SUDOERS}" ] && [ "\${LEGACY_INSTALLED_SUDOERS}" != "\${INSTALLED_SUDOERS}" ]; then
        info "legacy_installed: \${LEGACY_INSTALLED_SUDOERS}"
        ls -la "\${LEGACY_INSTALLED_SUDOERS}" 2>/dev/null || true
    fi
    # Sibling per-user fragments (multi-user host)
    for _sib in /etc/sudoers.d/\${APP_NAME}-*; do
        if [ -e "\${_sib}" ] && [ "\${_sib}" != "\${INSTALLED_SUDOERS}" ]; then
            info "other_user_fragment: \${_sib}"
        fi
    done
    if [ -f "\${PROJECT_SUDOERS_FILE}" ]; then
        info "draft: \${PROJECT_SUDOERS_FILE}"
        ls -la "\${PROJECT_SUDOERS_FILE}" 2>/dev/null || true
    else
        info "draft: (absent) \${PROJECT_SUDOERS_FILE}"
    fi
    info "generated_for_user=\${GEN_USER} trust_tier=\${GEN_TIER}"
}

usage() {
    cat <<U
Usage: sudo sh \$0 {install|uninstall|replace|status}
  install    visudo-check project sudoers file → install -m 0440 → per-user /etc/sudoers.d/
  uninstall  remove /etc/sudoers.d/${APP_NAME}-<user> for this script's user (leave elev)
  replace    uninstall then install (refresh host fragment from draft)
  status     show draft + installed presence (incl. legacy / other users if present)
Project sudoers file: \${PROJECT_SUDOERS_FILE}
Installed path:       \${INSTALLED_SUDOERS}
U
}

_action="\${1:-}"
case "\${_action}" in
    install)   cmd_install ;;
    uninstall) cmd_uninstall ;;
    replace)   cmd_replace ;;
    status)    cmd_status ;;
    -h|--help|help|"") usage; [ -n "\${_action}" ] || exit 1 ;;
    *) die "Unknown action: \${_action}"; usage; exit 1 ;;
esac
exit 0
EOF

    chmod 0750 "${_script_out}" 2>/dev/null || chmod +x "${_script_out}" 2>/dev/null || true

    out_success "Wrote admin sudoers script: ${_script_out}"
    out_info "Project sudoers file (draft): ${_draft}"
    out_info "Installed path (admin only, per-user): ${_installed}"
    out_empty_line
    out_info "Handoff — login as account with sudo, then:"
    out_plain "  sudo sh ${_script_out} install     # install/refresh THIS user's host fragment"
    out_plain "  sudo sh ${_script_out} uninstall   # remove THIS user's host fragment"
    out_plain "  sudo sh ${_script_out} replace     # uninstall then install"
    out_plain "  sudo sh ${_script_out} status"
    if [ "${_tier}" != "production" ]; then
        out_warn "TEST MODE trust_tier=${_tier}: after testing, admin should uninstall fragment soon."
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "print-sudoers-install-script" "written" \
            "script_path" "${_script_out}" \
            "project_sudoers_file" "${_draft}" \
            "installed_path" "${_installed}" \
            "user" "${_user}" \
            "trust_tier" "${_tier}"
    fi
    return 0
}

# =============================================================================
# gc_remove_project_sudoers() - Type 0: remove project-sudoers-file (draft only)
# =============================================================================
#
# GENERAL PURPOSE:
# Delete the product-owned project-sudoers-file draft(s). Default discovery lists
# drafts under ${HOME}/.config/${APP_NAME}/ (legacy sudoers.fragment +
# sudoers.fragment-<user>). When multiple drafts exist and no path arg is given,
# interactive mode lists them and lets the user choose; non-interactive requires
# an explicit path (or --force only when a single draft / current default).
# Never touches /etc/sudoers.d/. Confirm unless --force.
# Probes host installed path(s) and warns when elev is still active (honesty).
#
# ALIGNMENT:
# - term project-sudoers-file
# - requirement-three-layer-privilege-model.md §2.3.3b
#
# Last reviewed: 2026-08-09
# =============================================================================
gc_remove_project_sudoers() {
    : "${APP_NAME:=grok-cli}"
    : "${HOME:=/tmp}"
    : "${FORCE:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"

    _path="${1:-}"
    _installed=$(gc_default_installed_sudoers_path)
    _legacy=$(gc_legacy_installed_sudoers_path)
    _default_draft=$(gc_default_project_sudoers_path)
    _host_present=0
    _host_list=""
    _host_list=$(gc_list_host_sudoers_fragments 2>/dev/null || true)
    if [ -n "${_host_list}" ]; then
        _host_present=1
    fi

    # --- Resolve which draft path to remove ---
    if [ -z "${_path}" ]; then
        _draft_list=$(gc_list_project_sudoers_drafts 2>/dev/null || true)
        _count=0
        if [ -n "${_draft_list}" ]; then
            _count=$(printf '%s\n' "${_draft_list}" | grep -c . 2>/dev/null || echo 0)
        fi
        # normalize count (grep -c may leave trailing newline issues)
        _count=$(printf '%s' "${_count}" | tr -d '[:space:]')
        : "${_count:=0}"

        if [ "${_count}" -eq 0 ]; then
            _path="${_default_draft}"
        elif [ "${_count}" -eq 1 ]; then
            _path=$(printf '%s\n' "${_draft_list}" | head -n 1)
        else
            # Multiple drafts: list and choose (interactive) or fail closed with list
            out_info "Multiple project-sudoers-file drafts found under ${HOME}/.config/${APP_NAME}/:"
            _i=0
            # shellcheck disable=SC2039
            _indexed=""
            while IFS= read -r _line; do
                [ -n "${_line}" ] || continue
                _i=$((_i + 1))
                out_plain "  ${_i}) ${_line}"
                _indexed="${_indexed}${_i}|${_line}
"
            done <<EOF
${_draft_list}
EOF
            out_plain "  0) cancel"
            out_info "Pass an explicit path to remove one non-interactively, e.g.:"
            out_plain "  ${APP_NAME} remove-project-sudoers --force <path>"

            if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
                out_die "remove-project-sudoers: multiple drafts present; specify path argument (non-interactive)."
            fi

            prompt_ask "Choose draft number to remove" "0"
            _choice="${PROMPT_ASK_VALUE}"
            case "${_choice}" in
                ''|0|[Cc][Aa][Nn][Cc][Ee][Ll]*)
                    out_info "Remove cancelled"
                    return 0
                    ;;
                *[!0-9]*)
                    out_die "Invalid choice: ${_choice}"
                    ;;
            esac
            if [ "${_choice}" -lt 1 ] || [ "${_choice}" -gt "${_i}" ]; then
                out_die "Choice out of range: ${_choice} (1-${_i}, or 0 to cancel)"
            fi
            _path=$(printf '%s\n' "${_indexed}" | while IFS='|' read -r _n _p; do
                if [ "${_n}" = "${_choice}" ]; then
                    printf '%s' "${_p}"
                    break
                fi
            done)
            if [ -z "${_path}" ]; then
                out_die "Could not resolve choice ${_choice}"
            fi
        fi
    fi

    # Refuse removing under /etc as Type 0 (host elev is admin-only)
    case "${_path}" in
        /etc/*|/etc)
            out_die "Refusing to remove paths under /etc as Type 0. This command only deletes the user draft (project-sudoers-file). Host elev is admin-only: sudo rm ${_installed}  OR  ${APP_NAME} print-sudoers-install-script && sudo sh <script> uninstall"
            ;;
    esac

    _status=""
    if [ ! -e "${_path}" ]; then
        _status="already_absent"
        out_success "Project sudoers draft not present (nothing to remove): ${_path}"
    else
        if [ "${FORCE}" -eq 0 ]; then
            if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
                out_die "remove-project-sudoers requires confirmation. Re-run with --force in non-interactive mode."
            fi
            if ! prompt_yes_no "Remove project-sudoers-file draft ${_path}?"; then
                out_info "Remove cancelled"
                return 0
            fi
        fi
        if ! rm -f "${_path}"; then
            out_die "Failed to remove ${_path}"
        fi
        _status="removed"
        out_success "Removed project-sudoers-file draft: ${_path}"
    fi

    # Honesty: draft and host elev are two layers (L-SUDOERS-03). Multi-user: list all present.
    if [ "${JSON}" -eq 0 ]; then
        if [ "${_host_present}" -eq 1 ]; then
            out_warn "Host elevation STILL ACTIVE (separate from draft):"
            printf '%s\n' "${_host_list}" | while IFS= read -r _hp; do
                [ -n "${_hp}" ] || continue
                out_plain "  ${_hp}"
            done
            out_info "remove-project-sudoers only deletes the user draft — never /etc/sudoers.d/."
            out_info "Admin leave elev (this user): sudo rm ${_installed}"
            if [ -e "${_legacy}" ] && [ "${_legacy}" != "${_installed}" ]; then
                out_info "Admin leave elev (legacy shared): sudo rm ${_legacy}"
            fi
            out_info "Or handoff script: ${APP_NAME} print-sudoers-install-script && sudo sh <script> uninstall"
        else
            out_info "Host fragment also absent (no elev at ${_installed}; no legacy ${_legacy})."
        fi
    else
        if [ "${_status}" = "removed" ]; then
            out_json "remove-project-sudoers" "removed" \
                "path" "${_path}" \
                "status" "removed" \
                "installed_path" "${_installed}" \
                "host_fragment_present" "${_host_present}" \
                "note" "does not remove /etc/sudoers.d fragment"
        else
            out_json "remove-project-sudoers" "already absent" \
                "path" "${_path}" \
                "status" "already_absent" \
                "installed_path" "${_installed}" \
                "host_fragment_present" "${_host_present}"
        fi
    fi
    return 0
}


