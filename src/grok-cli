    out_plain "                       (test_local/unmanaged needs --allow-test-local);"
    out_plain "                       default: ~/.config/${APP_NAME}/sudoers.fragment-<user>"
    out_plain "  print-sudoers-install-script [path]"
    out_plain "                       Write admin install script (/dev/shm or temp) to install|uninstall|replace"
    out_plain "                       per-user fragment /etc/sudoers.d/${APP_NAME}-<user> (run with sudo)"
    out_plain "  remove-project-sudoers [path]"
    out_plain "                       Remove sudoers draft only (not host elev;"
    out_plain "                       lists drafts and lets you choose when multiple;"
    out_plain "                       confirm or --force; probes /etc/sudoers.d/ and warns if active)"
    out_plain "  generate-sudoer-request [path]"
    out_plain "                       Write a JSON grant you can read"
    out_plain "                       (Type 0 independent generate; compact; backup verb)."
    out_plain "                       Does not write /etc or inbound."
    out_plain "                       default: ~/.config/${APP_NAME}/sudoer-request-<user>.json"
    out_plain "  submit-sudoer-request [file]"
    out_plain "                       Queue the JSON grant inbound"
    out_plain "                       (Type 0: detect sudoer-cli + sudoer-adm; sibling writes"
    out_plain "                       JSON into /var/sudoer-cli/sudoer-request)"
    out_plain "                       action=update if this user's /etc/sudoers.d/${APP_NAME}-<user>"
    out_plain "                       (or legacy ${APP_NAME}) exists; else add"
    out_plain "                       (does not write /etc; does not mkdir inbound)"
    out_plain "                       Prefer: generate-sudoer-request, review, then submit file"
    out_empty_line
    out_info "Global Options:"
    out_plain "  --quiet, -q          Suppress info/success (errors still shown)"
    out_plain "  --json               Machine-readable JSON (implies --quiet)"
    out_plain "  --force              Force reinstall / skip uninstall confirm"
    out_plain "  --global             Install to GLOBAL_BIN (production elevation path)"
    out_plain "  --allow-test-local   Allow print-sudoers / generate-sudoer-request / submit when only local/unmanaged (TEST MODE)"
    out_plain "  --update             Force submit-sudoer-request action=update"
    out_plain "  --add                Force submit-sudoer-request action=add"
    out_plain "  --debug              Debug diagnostics on stderr (menu: elapsed of each paint step)"
    out_empty_line
    out_info "Environment:"
    out_plain "  SCRIPT_URL           grok-cli channel (default github raw src/grok-cli)"
    out_plain "  GROK_HOME            grok auth dir (default ~/.grok of invoking login)"
    out_plain "  GROK_CLI_ROOT        durable store (default /var/grok-cli)"
    out_plain "  GROK_CLI_CRONTAB     crontab binary (default crontab; tests inject a fake)"
    out_plain "  GROK_CLI_CRON_BACKUP backup crontab schedule (default */30 * * * *)"
    out_plain "  GROK_CLI_CRON_SYNC   sync-auth crontab schedule (default 45 * * * *)"
    out_plain "  GROK_CLI_SCP            scp binary (default scp; tests inject a fake)"
    out_plain "  GROK_CLI_REMOTE_ROOT    remote store path (default /var/grok-cli)"
    out_plain "  GROK_VENDOR_BASE_URL     xAI grok channel/artifact base (default https://x.ai/cli)"
    out_plain "  GROK_VENDOR_FALLBACK_URL xAI grok GCS fallback base"
    out_plain "  GROK_CHANNEL            grok channel (stable|alpha|enterprise; default stable)"
    out_plain "  GROK_SETUP_VERSION      pin grok version (skip channel pointer)"
    out_plain "  GROK_BIN             override path to peer grok"
    out_plain "  GROK_PROMPT_TIMEOUT  seconds for grok -p hello (default 20; always bounded)"
    out_plain "  GROK_PROMPT_KILL_AFTER  SIGKILL grace after the probe deadline (default 2)"
    out_plain "  USER_BIN / GLOBAL_BIN  install destinations"
    out_plain "  ALLOW_TEST_LOCAL_SUDOERS  1 = allow test-mode print-sudoers / generate / submit"
    out_plain "  SUDOER_CLI              override path to sudoer-cli"
    out_plain "  SUDOER_ADM_USER         approver login (default sudoer-adm)"
    out_plain "  SUDOER_QUEUE_INBOUND    override inbound approval dir"
    out_plain "  SUDOER_PUBLIC_ROOT      public queue root (default /var/sudoer-cli)"
    out_plain "  SUDOERS_D_DIR           host sudoers.d dir (default /etc/sudoers.d; tests)"
    out_empty_line
    out_info "Examples:"
    out_plain "  ${APP_NAME}                    # numbered list on a TTY; help off-TTY"
    out_plain "  curl -fsSL https://raw.githubusercontent.com/cloudgen/grok-cli/main/src/grok-cli | sh"
    out_plain "  ${APP_NAME} install"
    out_plain "  ${APP_NAME} setup                 # install grok from x.ai channel + artifact (not ${APP_NAME})"
    out_plain "  ${APP_NAME} run                   # start grok without auto-update (Termux)"
    out_plain "  ${APP_NAME} run -p hello          # one-shot prompt, still no auto-update"
    out_plain "  sudo ${APP_NAME} install          # global (production sudoers trust)"
    out_plain "  ${APP_NAME} print-sudoers --allow-test-local  # → sudoers.fragment-<user>"
    out_plain "  ${APP_NAME} print-sudoers-install-script   # → /dev/shm/…-sudoers-admin.sh"
    out_plain "  # admin (sudo rights): sudo sh /dev/shm/…-sudoers-admin.sh install|uninstall|replace"
    out_plain "  # host path is /etc/sudoers.d/${APP_NAME}-<user> (multi-user safe)"
    out_plain "  ${APP_NAME} remove-project-sudoers --force  # delete draft only (not /etc elev)"
    out_plain "  ${APP_NAME} generate-sudoer-request         # verified JSON under ~/.config/"
    out_plain "  ${APP_NAME} submit-sudoer-request           # JSON into /var/sudoer-cli/sudoer-request"
    out_plain "  ${APP_NAME} submit-sudoer-request ~/.config/${APP_NAME}/sudoer-request-\$(id -un).json"
    out_plain "  ${APP_NAME} menu"
    out_plain "  ${APP_NAME} check-session"
    out_plain "  ${APP_NAME} backup"
    out_plain "  ${APP_NAME} sync-auth"
    out_plain "  ${APP_NAME} sync-auth-from-remote user@192.0.2.10"
    out_plain "  ${APP_NAME} add-crontab"
    out_empty_line
    out_info "Empty argv on a real terminal shows the numbered list. Off-TTY empty argv is channel install-ensure (curl|sh)."
    out_info "Switches without a command (--debug, --quiet) still follow empty argv. ${APP_NAME} --json with no command is empty argv special case: JSON help (even on a TTY). Explicit help stays help."
    out_info "backup runs grok -p hello first, then passwordless sudo ${APP_NAME} backup (sudoer-adm)."
    out_info "sync-auth never uses sudo. Local install + sudoers is TEST MODE ONLY; prefer global."
}

# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher for grok-cli (specialized from folder-backup; local Type 0 + grok auth domain).
# Empty argv = no command token after flag parse (overlay --debug/--quiet follow).
# TTY menu; off-TTY Type O channel ensure. --json with no command is 0-argv
# special case: JSON help on TTY and off-TTY.
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-zero-arguments.md
# - requirement-shell-cli-default-interaction.md
# - requirement-grok-setup.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-09-07
# =============================================================================
app_main() {
    COMMAND=""
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${APP_NAME:=grok-cli}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/cache-${APP_NAME}}"

    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR PERSISTENT_STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # Empty argv = no command token after flag parse (overlay --debug/--quiet
    # follow). TTY → menu. Off-TTY → Type O ensure.
    # --json no-command is 0-argv special case → JSON help (TTY and off-TTY).
    _saw_command=0
    _domain_arg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --allow-test-local)
                ALLOW_TEST_LOCAL_SUDOERS=1
                export ALLOW_TEST_LOCAL_SUDOERS
                ;;
            --purpose)
                if [ $# -lt 2 ]; then
                    out_die "--purpose requires TEXT"
                fi
                SUBMIT_PURPOSE="$2"
                export SUBMIT_PURPOSE
                shift
                ;;
            --update)
                SUBMIT_ACTION="update"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            --add)
                SUBMIT_ACTION="add"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            version|about|help|menu|main|install|uninstall|where-is-me|version-check|self-update|self-uninstall|setup|check-session|backup|sync-auth|sync-auth-from-remote|add-crontab|print-sudoers|print-sudoers-install-script|remove-project-sudoers|generate-sudoer-request|submit-sudoer-request)
                COMMAND="$1"
                _saw_command=1
                ;;
            run)
                COMMAND="$1"
                _saw_command=1
                shift
                break
                ;;
            *)
                # Positional operands for domain verbs
                if [ "${COMMAND}" = "print-sudoers" ] \
                    || [ "${COMMAND}" = "print-sudoers-install-script" ] \
                    || [ "${COMMAND}" = "remove-project-sudoers" ] \
                    || [ "${COMMAND}" = "generate-sudoer-request" ] \
                    || [ "${COMMAND}" = "submit-sudoer-request" ] \
                    || [ "${COMMAND}" = "sync-auth-from-remote" ]; then
                    if [ -z "${_domain_arg}" ]; then
                        _domain_arg="$1"
                    else
                        out_die "Unexpected argument: $1. See '${APP_NAME} help'."
                    fi
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    if [ "${_saw_command}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ]; then
            COMMAND=help
        elif [ "${TTY}" -eq 1 ]; then
            COMMAND=menu
        else
            COMMAND=ensure
        fi
    fi

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} force_global=${FORCE_GLOBAL} allow_test_local=${ALLOW_TEST_LOCAL_SUDOERS}"

    case "${COMMAND}" in
        version)      app_version ;;
        about)        app_about ;;
        menu|main)    app_default ;;
        ensure)       inst_channel_ensure ;;
        install)      inst_local_install ;;
        uninstall)    inst_local_uninstall ;;
        where-is-me)  app_where_is_me ;;
        version-check) ver_check ;;
        self-update)  inst_self_update ;;
        self-uninstall) inst_self_uninstall ;;
        setup)        gc_setup ;;
        run)          gc_run_grok "$@" ;;
        check-session) gc_check_session ;;
        backup)       gc_backup ;;
        sync-auth)    gc_sync_auth ;;
        sync-auth-from-remote) gc_sync_auth_from_remote "${_domain_arg}" ;;
        add-crontab)  gc_add_crontab ;;
        print-sudoers) gc_print_sudoers "${_domain_arg}" ;;
        print-sudoers-install-script) gc_print_sudoers_install_script "${_domain_arg}" ;;
        remove-project-sudoers) gc_remove_project_sudoers "${_domain_arg}" ;;
        generate-sudoer-request) gc_generate_sudoer_request "${_domain_arg}" ;;
        submit-sudoer-request) gc_submit_sudoer_request "${_domain_arg}" ;;
        help|*)       app_help ;;
    esac
}

