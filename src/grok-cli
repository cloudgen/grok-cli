    fi

    _installed="false"
    inst_is_installed && _installed="true"

    _global_ver="not found"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _local_ver="not found"
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        _local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _shell=$(util_get_current_shell)
    _user=$(id -un 2>/dev/null || echo "unknown")
    _interactive="false"
    [ "${TTY:-0}" -eq 1 ] && _interactive="true"

    # Best-effort sudo deposit probe
    _sudo_deposit="unknown"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        _sudo_deposit="root"
    elif command -v sudo >/dev/null 2>&1; then
        if sudo -n true 2>/dev/null; then
            _sudo_deposit="sudo_n_ok"
        else
            _sudo_deposit="sudo_needs_auth_or_denied"
        fi
    else
        _sudo_deposit="no_sudo"
    fi

    _sudoer_cli="not_found"
    if _scli_path=$(gc_detect_sudoer_cli); then
        _sudoer_cli="${_scli_path}"
    fi
    _sudoer_adm="absent"
    if _sadm_name=$(gc_detect_sudoer_adm); then
        _sudoer_adm="${_sadm_name}"
    fi
    _sudoer_inbound="not_found"
    _sudoer_inbound_writable="false"
    if _sin_path=$(gc_detect_sudoer_inbound); then
        _sudoer_inbound="${_sin_path}"
        if [ -w "${_sin_path}" ]; then
            _sudoer_inbound_writable="true"
        fi
    fi

    _host_sudoers_present="false"
    _host_sudoers_path=""
    if _hsp=$(gc_probe_current_user_host_sudoers); then
        _host_sudoers_present="true"
        _host_sudoers_path="${_hsp}"
    fi

    _grok_peer_json=$(gc_resolve_grok_peer)
    [ -n "${_grok_peer_json}" ] || _grok_peer_json="not_found"

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "cache_preferred" "${_cache_preferred}" \
            "cache_fallback" "${_cache_fallback}" \
            "persistence_storage" "${PERSISTENT_STORAGE_DIR}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "grok_home" "$(gc_resolve_grok_home)" \
            "grok_cli_root" "${GROK_CLI_ROOT}" \
            "deposit_dir" "${GROK_CLI_ROOT}" \
            "session" "$(gc_session_status_word 2>/dev/null || echo missing)" \
            "sudo_deposit" "${_sudo_deposit}" \
            "sudoers_trust_tier" "$(gc_sudoers_trust_tier)" \
            "sudoer_cli" "${_sudoer_cli}" \
            "sudoer_adm" "${_sudoer_adm}" \
            "sudoer_inbound" "${_sudoer_inbound}" \
            "sudoer_inbound_writable" "${_sudoer_inbound_writable}" \
            "host_sudoers_present" "${_host_sudoers_present}" \
            "host_sudoers_path" "${_host_sudoers_path}" \
            "grok_peer" "${_grok_peer_json}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    _tier=$(gc_sudoers_trust_tier)
    out_info "Sudoers trust tier: ${_tier}  (production requires global; local-only = test mode)"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (Type 0 + narrow Type 1 deposit)"
    fi
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ "${TTY:-0}" -eq 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "Cache folder (preferred): ${_cache_preferred}"
    out_info "Cache folder (fallback):  ${_cache_fallback}"
    out_info "Persistence storage:      ${PERSISTENT_STORAGE_DIR}"
    out_empty_line
    _grok_peer=$(gc_resolve_grok_peer)
    if [ -n "${_grok_peer}" ]; then
        out_info "Grok CLI (xAI):    ${_grok_peer}"
    else
        out_info "Grok CLI (xAI):    not found — ${APP_NAME} setup installs it"
    fi
    out_info "Grok home:         $(gc_resolve_grok_home)"
    out_info "Session:           $(gc_session_status_word 2>/dev/null || echo missing)"
    out_info "Deposit directory: ${GROK_CLI_ROOT}"
    out_info "Sudo deposit:      ${_sudo_deposit}"
    out_info "sudoer-cli:        ${_sudoer_cli}"
    out_info "sudoer-adm:        ${_sudoer_adm}"
    if [ "${_sudoer_inbound}" = "not_found" ]; then
        out_info "sudoer inbound:    not_found (preferred ${SUDOER_PUBLIC_ROOT:-/var/sudoer-cli}/sudoer-request)"
    else
        out_info "sudoer inbound:    ${_sudoer_inbound} (writable=${_sudoer_inbound_writable})"
    fi
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} menu            → Numbered list of live commands (real terminal)"
    out_info "   ${APP_NAME} install         → Local install to ~/.local/bin"
    out_info "   ${APP_NAME} print-sudoers   → Sudoers fragment for admin"
    out_info "   ${APP_NAME} generate-sudoer-request → Write a local JSON grant you can verify"
    out_info "   ${APP_NAME} submit-sudoer-request → JSON request into /var/sudoer-cli/sudoer-request"
    out_info "   ${APP_NAME} check-session   → Confirm grok is logged in (grok -p hello)"
    out_info "   ${APP_NAME} backup          → Push ~/.grok/auth.* to /var/grok-cli (sudo grant)"
    out_info "   ${APP_NAME} sync-auth       → Copy /var/grok-cli/auth.* into ~/.grok (no sudo)"
    out_info "   ${APP_NAME} --json          → Machine-readable output"
}

# =============================================================================
# gc_host_is_termux() / gc_host_is_git_bash() / gc_host_is_windows_cmd()
# gc_host_is_normal_user_only() / gc_host_normal_user_only_label()
# =============================================================================
#
# GENERAL PURPOSE:
# Detect command-line-for-normal-user-only hosts (this login only: Termux,
# Git Bash, Windows cmd). Label is termux / gitbash / windows-cmd for the
# main-menu not-available line.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-interface.md
#
# Last updated: 2026-09-07
# =============================================================================
gc_host_is_termux() {
    if [ -n "${TERMUX_VERSION:-}" ]; then
        return 0
    fi
    if [ -n "${PREFIX:-}" ]; then
        return 0
    fi
    gc_setup_host_is_android
}

gc_host_is_git_bash() {
    if [ -n "${MSYSTEM:-}" ]; then
        return 0
    fi
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*) return 0 ;;
    esac
    return 1
}

gc_host_is_windows_cmd() {
    if [ "${OS:-}" != "Windows_NT" ]; then
        return 1
    fi
    if gc_host_is_git_bash; then
        return 1
    fi
    case "$(uname -s 2>/dev/null)" in
        CYGWIN*|MINGW*|MSYS*) return 1 ;;
    esac
    if [ -n "${WSL_DISTRO_NAME:-}" ] || [ -n "${WSL_INTEROP:-}" ]; then
        return 1
    fi
    case "$(uname -r 2>/dev/null)" in
        *[Mm]icrosoft*) return 1 ;;
    esac
    return 0
}

gc_host_is_normal_user_only() {
    if gc_host_is_termux; then
        return 0
    fi
    if gc_host_is_git_bash; then
        return 0
    fi
    gc_host_is_windows_cmd
}

gc_host_normal_user_only_label() {
    if gc_host_is_termux; then
        printf '%s' "termux"
        return 0
    fi
    if gc_host_is_git_bash; then
        printf '%s' "gitbash"
        return 0
    fi
    if gc_host_is_windows_cmd; then
        printf '%s' "windows-cmd"
        return 0
    fi
    printf '%s' ""
}

# =============================================================================
# gc_menu_main_tokens() - Visible main-menu tokens (one per line, board order)
# =============================================================================
#
# GENERAL PURPOSE:
# Class B: print the listed main-menu tokens for this host and session.
# Consumes GC_SESSION_STATUS_CACHE (valid = logged in). Hide backup /
# sync-auth / sudoers on this-login-only hosts. Those hosts list run
# first (start grok without auto-update). Hide sync-auth and
# sync-auth-from-remote when the session is valid.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-07
# =============================================================================
gc_menu_main_tokens() {
    if gc_host_is_normal_user_only; then
        printf '%s\n' "run"
    fi
    if ! gc_host_is_normal_user_only; then
        printf '%s\n' "backup"
        if [ "${GC_SESSION_STATUS_CACHE-}" != "valid" ]; then
            printf '%s\n' "sync-auth"
        fi
    fi
    if [ "${GC_SESSION_STATUS_CACHE-}" != "valid" ]; then
        printf '%s\n' "sync-auth-from-remote"
    fi
    printf '%s\n' "add-crontab"
    if ! gc_host_is_normal_user_only; then
        printf '%s\n' "sudoers"
    fi
}

# =============================================================================
# gc_menu_row_explain() - Class B: explain text for one main-menu token
# =============================================================================
gc_menu_row_explain() {
    : "${GROK_CLI_ROOT:=/var/grok-cli}"
    case "${1-}" in
        run) printf '%s' "Start grok without auto-update" ;;
        backup) printf '%s' "Push ~/.grok/auth.* to ${GROK_CLI_ROOT}" ;;
        sync-auth) printf '%s' "Copy ${GROK_CLI_ROOT}/auth.* into ~/.grok" ;;
        sync-auth-from-remote) printf '%s' "Copy a remote host's auth.* into ~/.grok" ;;
        add-crontab) printf '%s' "Add backup and sync-auth jobs to this login's crontab" ;;
        sudoers) printf '%s' "Grant and drafts" ;;
        *) printf '%s' "" ;;
    esac
}

# =============================================================================
# gc_menu_main_count() - Class B: number of listed main-menu command rows
# =============================================================================
gc_menu_main_count() {
    _c=0
    while IFS= read -r _tok; do
        [ -n "${_tok}" ] || continue
        _c=$((_c + 1))
    done <<EOF
$(gc_menu_main_tokens)
EOF
    printf '%s' "${_c}"
}

# =============================================================================
# gc_menu_pick_is_sudoers() - 0 when pick is the listed sudoers family
# =============================================================================
gc_menu_pick_is_sudoers() {
    _want="${1-}"
    _n=0
    while IFS= read -r _tok; do
        [ -n "${_tok}" ] || continue
        _n=$((_n + 1))
        if [ "${_tok}" = "sudoers" ]; then
            if [ "${_want}" = "sudoers" ] || [ "${_want}" = "${_n}" ]; then
                return 0
            fi
            return 1
        fi
    done <<EOF
$(gc_menu_main_tokens)
EOF
    return 1
}

# =============================================================================
# app_default_print_menu() - Numbered main-menu list (TTY)
# =============================================================================
#
# GENERAL PURPOSE:
# Print the grok-cli daily-work list: APP_NAME(APP_VERSION) header plus
# SHORT_DESCRIPTION, login status, host not-available (this-login-only),
# appended logged-in not-available when session is valid, then remaining
# listed rows from 1, then Exit 9. Session status is under the title
# (not a row). Host not-available is never replaced by the logged-in line.
# Reuse GC_SESSION_STATUS_CACHE on reprint so a bad pick does not run
# grok -p hello again (Termux freeze).
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-internal-volatile-timer.md
#
# Last updated: 2026-09-07
# =============================================================================
app_default_print_menu() {
    : "${APP_NAME:=grok-cli}"
    : "${GROK_CLI_ROOT:=/var/grok-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Alternative online installer for xAI grok}}"

    util_int_timer_debug_begin "paint"

    util_int_timer_debug_begin "header"
    out_info "$(util_app_ident) — ${SHORT_DESCRIPTION}"
    util_int_timer_debug_end "header"

    util_int_timer_debug_begin "session"
    if [ -n "${GC_SESSION_STATUS_CACHE:-}" ]; then
        _st="${GC_SESSION_STATUS_CACHE}"
    else
        _st=$(gc_session_status_word) || true
        GC_SESSION_STATUS_CACHE="${_st}"
        export GC_SESSION_STATUS_CACHE
    fi
    if [ "${_st}" = "valid" ]; then
        out_plain "logged in"
    else
        out_plain "logged out"
    fi
    util_int_timer_debug_end "session"

    util_int_timer_debug_begin "host"
    if gc_host_is_normal_user_only; then
        out_plain "backup, sync-auth and sudoers features are not available in $(gc_host_normal_user_only_label)."
    fi
    util_int_timer_debug_end "host"

    util_int_timer_debug_begin "logged-in"
    if [ "${_st}" = "valid" ]; then
        out_plain "sync-auth and sync-auth-from-remote features are not available for logged-in environment."
    fi
    util_int_timer_debug_end "logged-in"

    util_int_timer_debug_begin "rows"
    _n=0
    while IFS= read -r _tok; do
        [ -n "${_tok}" ] || continue
        _n=$((_n + 1))
        out_menu_choice "${_n}" "${_tok}" "$(gc_menu_row_explain "${_tok}")"
    done <<EOF
$(gc_menu_main_tokens)
EOF
    out_menu_choice "9" "Exit"
    util_int_timer_debug_end "rows"

    util_int_timer_debug_end "paint"
}

# =============================================================================
# app_default_print_sudoers_menu() - Sudoers family submenu (TTY)
# =============================================================================
#
# GENERAL PURPOSE:
# Print the grant/draft list grouped behind main-menu family row sudoers.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-internal-volatile-timer.md
#
# Last updated: 2026-09-07
# =============================================================================
app_default_print_sudoers_menu() {
    : "${APP_NAME:=grok-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"

    util_int_timer_debug_begin "sudoers.paint"

    util_int_timer_debug_begin "sudoers.header"
    out_info "$(util_app_ident) — sudoers (grant and drafts)"
    util_int_timer_debug_end "sudoers.header"

    util_int_timer_debug_begin "sudoers.rows"
    out_menu_choice "1" "generate-sudoer-request" "Write a JSON grant you can read"
    out_menu_choice "2" "submit-sudoer-request" "Queue the JSON grant inbound"
    out_menu_choice "3" "print-sudoers" "Emit sudoers draft"
    out_menu_choice "4" "print-sudoers-install-script" "Write admin install script"
    out_menu_choice "5" "remove-project-sudoers" "Remove sudoers draft only"
    out_menu_choice "8" "Back"
    out_menu_choice "9" "Exit"
    util_int_timer_debug_end "sudoers.rows"

    util_int_timer_debug_end "sudoers.paint"
}

# =============================================================================
# app_default_run_pick() - Run one main-menu choice (number or verb)
# =============================================================================
#
# GENERAL PURPOSE:
# Map a main-list pick to a live handler using the same visible-token list
# as the printer. Family row sudoers is not handled here (caller opens the
# submenu). Returns 1 if the pick is not on the list. Returns 0 after a
# run or Exit. Hidden rows (host or logged-in) MUST NOT run from a number.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-09-07
# =============================================================================
app_default_run_pick() {
    _pick="${1:-}"
    : "${GROK_CLI_ROOT:=/var/grok-cli}"

    case "${_pick}" in
        check-session)
            gc_check_session
            return 0
            ;;
        9|99|exit|quit|Exit|QUIT)
            return 0
            ;;
    esac

    if ! gc_host_is_normal_user_only; then
        case "${_pick}" in
            generate-sudoer-request)
                gc_generate_sudoer_request
                return 0
                ;;
            submit-sudoer-request)
                gc_submit_sudoer_request
                return 0
                ;;
            print-sudoers)
                gc_print_sudoers
                return 0
                ;;
            print-sudoers-install-script)
                gc_print_sudoers_install_script
                return 0
                ;;
            remove-project-sudoers)
                gc_remove_project_sudoers
                return 0
                ;;
        esac
    fi

    _run=""
    _n=0
    while IFS= read -r _tok; do
        [ -n "${_tok}" ] || continue
        _n=$((_n + 1))
        if [ "${_pick}" = "${_n}" ] || [ "${_pick}" = "${_tok}" ]; then
            _run="${_tok}"
            break
        fi
    done <<EOF
$(gc_menu_main_tokens)
EOF

    case "${_run}" in
        run)
            gc_run_grok
            ;;
        backup)
            gc_backup
            ;;
        sync-auth)
            gc_sync_auth
            ;;
        sync-auth-from-remote)
            gc_sync_auth_from_remote
            ;;
        add-crontab)
            gc_add_crontab
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

# =============================================================================
# app_default_run_sudoers_pick() - Run one sudoers-submenu choice
# =============================================================================
#
# GENERAL PURPOSE:
# Map a submenu number or member verb to the live handler. Back/Exit are
# owned by the submenu loop. Returns 1 if the pick is not a member.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-08-23
# =============================================================================
app_default_run_sudoers_pick() {
    _pick="${1:-}"

    case "${_pick}" in
        1|generate-sudoer-request)
            gc_generate_sudoer_request
            ;;
        2|submit-sudoer-request)
            gc_submit_sudoer_request
            ;;
        3|print-sudoers)
            gc_print_sudoers
            ;;
        4|print-sudoers-install-script)
            gc_print_sudoers_install_script
            ;;
        5|remove-project-sudoers)
            gc_remove_project_sudoers
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

# =============================================================================
# app_default_sudoers_loop() - Interactive sudoers submenu
# =============================================================================
#
# GENERAL PURPOSE:
# Show the grant/draft list. Back returns 1 (main list). Exit or a run
# returns 0 (leave menu). Never hangs off-TTY (caller is TTY-only).
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
#
# Last updated: 2026-08-23
# =============================================================================
app_default_sudoers_loop() {
    : "${APP_NAME:=grok-cli}"
    : "${_menu_json:=0}"
    : "${_menu_quiet:=0}"

    while true; do
        JSON=0
        QUIET=0
        export JSON QUIET
        app_default_print_sudoers_menu
        out_msg_n "Choice: "
        _pick=""
        if ! read -r _pick; then
            return 0
        fi
        case "${_pick}" in
            8|back|Back)
                return 1
                ;;
            9|99|exit|quit|Exit|QUIT)
                return 0
                ;;
        esac
        JSON="${_menu_json}"
        QUIET="${_menu_quiet}"
        export JSON QUIET
        if app_default_run_sudoers_pick "${_pick}"; then
            return 0
        fi
        out_warn "Not a menu choice. Type 1-5, 8 back, 9 to leave, or a listed command name. Next: ${APP_NAME} menu"
    done
}

# =============================================================================
# app_default() - Default interaction: TTY numbered menu / off-TTY help
# =============================================================================
#
# GENERAL PURPOSE:
# Command menu / main / TTY empty argv. On a real terminal: ignore --json on
# menu/main, show the numbered list, run one pick (or open the sudoers submenu).
# Off-TTY: help (JSON help when --json). Never hang.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-interactive-vs-noninteractive.md
# - requirement-shell-cli-zero-arguments.md
#
# Last updated: 2026-09-07
# =============================================================================
app_default() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=grok-cli}"

    if [ "${TTY}" -ne 1 ]; then
        _menu_quiet="${QUIET}"
        if [ "${JSON}" -ne 1 ]; then
            QUIET=0
        fi
        app_help
        QUIET="${_menu_quiet}"
        return 0
    fi

    _menu_json="${JSON}"
    _menu_quiet="${QUIET}"
    JSON=0
    QUIET=0
    export JSON QUIET

    while true; do
        app_default_print_menu
        out_msg_n "Choice: "
        _pick=""
        if ! read -r _pick; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            return 0
        fi
        case "${_pick}" in
            9|99|exit|quit|Exit|QUIT)
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
                ;;
        esac
        if gc_menu_pick_is_sudoers "${_pick}"; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            export JSON QUIET
            if app_default_sudoers_loop; then
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                export JSON QUIET
                return 0
            fi
            JSON=0
            QUIET=0
            export JSON QUIET
            continue
        fi
        JSON="${_menu_json}"
        QUIET="${_menu_quiet}"
        export JSON QUIET
        if app_default_run_pick "${_pick}"; then
            return 0
        fi
        JSON=0
        QUIET=0
        export JSON QUIET
        _menu_n=$(gc_menu_main_count)
        if [ "${_menu_n}" -eq 1 ]; then
            out_warn "Not a menu choice. Type 1, 9 to leave, or a listed command name. Next: ${APP_NAME} menu"
        else
            out_warn "Not a menu choice. Type 1-${_menu_n}, 9 to leave, or a listed command name. Next: ${APP_NAME} menu"
        fi
    done
}

# =============================================================================
# app_help() - Usage (local Type 0 + domain)
# =============================================================================
#
# Last updated: 2026-09-07
# =============================================================================
app_help() {
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Alternative online installer for xAI grok}}"
    : "${DESCRIPTION:=POSIX /bin/sh CLI: install, uninstall, where-is-me, version, about, help, menu, version-check, self-update, self-uninstall, setup, run, check-session, backup, sync-auth, sync-auth-from-remote, add-crontab, print-sudoers, print-sudoers-install-script, remove-project-sudoers, generate-sudoer-request, submit-sudoer-request.}"
    : "${GROK_CLI_ROOT:=/var/grok-cli}"

    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
            "command" "help" \
            "note" "Use --json with version, about, install, uninstall, where-is-me, check-session, backup, sync-auth, sync-auth-from-remote, add-crontab. Empty argv and menu/main off-TTY use this help."
        return 0
    fi
    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
    out_plain "${DESCRIPTION}"
    out_empty_line
    out_info "Usage:"
    out_plain "  ${APP_NAME} [command] [options]"
    out_empty_line
    out_info "Lifecycle (Type 0 — local self-managed):"
    out_plain "  install              Install ${APP_NAME} (root→global, user→~/.local/bin)"
    out_plain "  install --global     Force global path (${GLOBAL_BIN}; needs write/root)"
