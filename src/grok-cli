# Last updated: 2026-08-30
# =============================================================================
app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=grok-cli}"
    : "${VERSION:=1.0.0}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=grok-cli}"
    : "${SCRIPT_URL:=}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${USERNAME:=unknown}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${GROK_CLI_ROOT:=/var/grok-cli}"

